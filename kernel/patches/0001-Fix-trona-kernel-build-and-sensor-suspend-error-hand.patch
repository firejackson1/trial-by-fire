diff --git a/tools/testing/selftests/mediatek/check_sensor_suspend.py b/tools/testing/selftests/mediatek/check_sensor_suspend.py
new file mode 100755
index 00000000000..9bd15dec0fc
--- /dev/null
+++ b/tools/testing/selftests/mediatek/check_sensor_suspend.py
@@ -0,0 +1,70 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0
+"""Exercise the candidate kernel's actual sensor suspend function on the host."""
+import pathlib
+import subprocess
+import sys
+import tempfile
+
+root = pathlib.Path(sys.argv[1])
+driver = sys.argv[2] if len(sys.argv) > 2 else "ltrx"
+assert driver in ("ltrx", "stk")
+folder, suspend, resume = (
+    ("ltrx130a_dual", "ltrx130a_i2c_suspend", "ltrx130a_i2c_resume")
+    if driver == "ltrx" else ("stk3x1x_dual", "stk3x1x_suspend", "stk3x1x_resume")
+)
+source = (root / "drivers/misc/mediatek/sensors-1.0/alsps" / folder / (folder + ".c")).read_text()
+start = source.index("static int " + suspend + "(struct device *dev)\n{")
+end = source.index("\nstatic int " + resume + "(", start)
+function = source[start:end]
+prefix = r"""
+#include <assert.h>
+#include <errno.h>
+#include <stddef.h>
+struct device { int unused; };
+struct i2c_client { int index; };
+struct sensor { struct i2c_client *client; };
+static struct { int als_suspend, als_count; struct sensor *als[2]; } ltrx130a_dual;
+static int paused, calls, results[2];
+#define APS_FUN() ((void)0)
+#define APS_ERR(...) ((void)0)
+#define atomic_read(p) (*(p))
+#define atomic_set(p, v) (*(p) = (v))
+static void alsps_driver_pause_polling(int value) { paused = value; }
+static int ltrx130a_als_enable(struct i2c_client *client, int enabled) {
+    (void)enabled; ++calls; return results[client->index];
+}
+"""
+cases = r"""
+int main(void) {
+    struct i2c_client clients[] = {{0}, {1}};
+    struct sensor sensors[] = {{&clients[0]}, {&clients[1]}};
+    ltrx130a_dual.als_count = 2;
+    ltrx130a_dual.als[0] = &sensors[0];
+    ltrx130a_dual.als[1] = &sensors[1];
+    results[0] = -EIO;
+    assert(ltrx130a_i2c_suspend(NULL) == -EIO);
+    assert(calls == 1 && !paused && !ltrx130a_dual.als_suspend);
+    results[0] = 0; calls = 0;
+    assert(ltrx130a_i2c_suspend(NULL) == 0);
+    assert(calls == 2 && paused && ltrx130a_dual.als_suspend);
+    assert(ltrx130a_i2c_suspend(NULL) == 0 && calls == 2);
+    ltrx130a_dual.als_suspend = 0; calls = 0; results[1] = -EINVAL;
+    assert(ltrx130a_i2c_suspend(NULL) == -EINVAL);
+    assert(calls == 2 && !paused && !ltrx130a_dual.als_suspend);
+    ltrx130a_dual.als[0] = NULL; calls = 0;
+    assert(ltrx130a_i2c_suspend(NULL) == -EINVAL);
+    assert(!calls && !paused && !ltrx130a_dual.als_suspend);
+    ltrx130a_dual.als_count = 0;
+    assert(ltrx130a_i2c_suspend(NULL) == 0);
+    return 0;
+}
+"""
+if driver == "stk":
+    prefix += "\n#define stk3x1x_dual ltrx130a_dual\n#define stk3x1x_enable_als ltrx130a_als_enable\n#define stk3x1x_suspend ltrx130a_i2c_suspend\n"
+with tempfile.TemporaryDirectory(prefix="trona-suspend-") as temporary:
+    path = pathlib.Path(temporary)
+    (path / "check.c").write_text(prefix + function + cases)
+    subprocess.run(["gcc", "-std=c99", "-O0", str(path / "check.c"), "-o", str(path / "check")], check=True)
+    subprocess.run([str(path / "check")], check=True, cwd=path)
+print("PASS:", driver, "suspend propagates errors and restores polling state")
