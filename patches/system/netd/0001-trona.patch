+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+#include <sys/types.h>
+
+namespace trona::network {
+
+// Fresh UPDATE_DEVICE_STATS query for an already authenticated peer identity.
+// Returns 0 only for a successful canonical grant reply; denial and discovery,
+// transport or parsing errors return negative errno. Nothing is cached.
+// Service discovery and Binder transact are synchronous and can hang. Call only
+// from a bounded worker whose caller can fail closed; never a netd listener loop.
+int QueryUpdateDeviceStatsPermission(pid_t authenticatedPid, uid_t authenticatedUid);
+
+}  // namespace trona::network
