@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "SocketClientTagCompletion.h"
+
+#include <cstdlib>
+#include <sys/socket.h>
+#include <sysutils/SocketClient.h>
+
+namespace trona::network {
+
+SocketClientTagCompletion::SocketClientTagCompletion(SocketClient* client) : client_(client) {
+    if (!client_) std::abort();  // Internal programming error; never select an unauthenticated lease.
+    client_->incRef();
+}
+
+SocketClientTagCompletion::~SocketClientTagCompletion() { client_->decRef(); }
+
+void SocketClientTagCompletion::complete(int error) noexcept {
+    static_assert(sizeof(error) == 4, "FwmarkClient expects a four-byte native error value");
+    // A single nonblocking reply attempt, never SocketClient's blocking writev.
+    // Short/failed sends are followed by final ref release/connection close.
+    // The handoff contract makes this the only writer for this one-shot client.
+    (void)send(client_->getSocket(), &error, sizeof(error), MSG_DONTWAIT | MSG_NOSIGNAL);
+}
+
+}  // namespace trona::network
diff --git a/server/trona/tag-auth/SocketClientTagCompletion.h b/server/trona/tag-auth/SocketClientTagCompletion.h
