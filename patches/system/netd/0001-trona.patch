+// SPDX-License-Identifier: Apache-2.0
+#include "NetdRestoreAdapter.h"
+#include <cerrno>
+#include <memory>
+#include "NetdConstants.h"
+
+namespace trona::network {
+int RestoreViaNetd(const std::string& command) {
+    // netd currently returns 0/-1 without an errno guarantee. Do not interpret -1
+    // as EPERM or use stale errno after sequential IPv4 and IPv6 execution.
+    return ::execIptablesRestore(V4V6, command) == 0 ? 0 : -EREMOTEIO;
+}
+}
