index 0000000..9fdb05e
--- /dev/null
+++ b/server/trona/tag-auth/LegacyTagPermissionOracle.cpp
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "LegacyTagPermissionOracle.h"
+
+#include <binder/IBinder.h>
+#include <binder/IPermissionController.h>
+#include <binder/IServiceManager.h>
+#include <binder/Parcel.h>
+#include <binder/Status.h>
+#include <utils/String16.h>
+
+#include <cerrno>
+#include <cstdint>
+#include <limits>
+
+namespace trona::network {
+
+int QueryUpdateDeviceStatsPermission(pid_t authenticatedPid, uid_t authenticatedUid) {
+    if (authenticatedPid <= 0 || authenticatedUid >
+            static_cast<uid_t>(std::numeric_limits<int32_t>::max())) {
+        return -EINVAL;
+    }
+
+    const auto manager = android::defaultServiceManager();
+    if (manager == nullptr) return -EAGAIN;
+    const auto controller = manager->checkService(android::String16("permission"));
+    if (controller == nullptr) return -EAGAIN;
+
+    android::Parcel request;
+    android::Parcel reply;
+    if (request.writeInterfaceToken(android::IPermissionController::descriptor)
+                    != android::OK ||
+        request.writeString16(android::String16("android.permission.UPDATE_DEVICE_STATS"))
+                    != android::OK ||
+        request.writeInt32(static_cast<int32_t>(authenticatedPid)) != android::OK ||
+        request.writeInt32(static_cast<int32_t>(authenticatedUid)) != android::OK) {
+        return -EREMOTEIO;
+    }
+    if (controller->transact(android::IPermissionController::CHECK_PERMISSION_TRANSACTION,
+                             request, &reply) != android::OK) {
+        return -EREMOTEIO;
+    }
+
+    if (reply.objectsCount() != 0) return -EBADMSG;
+    android::binder::Status status;
+    if (status.readFromParcel(reply) != android::OK || !status.isOk()) return -EREMOTEIO;
+    if (reply.dataAvail() != sizeof(int32_t)) return -EBADMSG;
+    int32_t granted = 0;
+    if (reply.readInt32(&granted) != android::OK || (granted != 0 && granted != 1)) {
+        return -EBADMSG;
+    }
+    return granted == 1 ? 0 : -EACCES;
+}
+
+}  // namespace trona::network
