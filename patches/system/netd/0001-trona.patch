+int IptablesRestoreController::executeTableSnapshot(
+        IptablesTarget target, const std::string& table, const std::string& parent,
+        const TableUpdate& prepare) {
+    // Restrict command framing to single names, not restore command fragments.
+    const auto validName = [](const std::string& name) {
+        return !name.empty() && name.size() <= 28 &&
+               name.find_first_not_of("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
+                                      "0123456789_-") == std::string::npos;
+    };
+    if ((target != V4 && target != V6) || !validName(table) || !validName(parent) || !prepare) {
+        return -EINVAL;
+    }
+    std::lock_guard lock(mLock);
+    const auto type = target == V4 ? IPTABLES_PROCESS : IP6TABLES_PROCESS;
+    auto& process = target == V4 ? mIpRestore : mIp6Restore;
+    const auto abort = [&]() {
+        if (process) process->stop();
+        process.reset();
+    };
+    std::string listing;
+    // In this checkout, verbose comment markers are acknowledged inside a table. The
+    // restore parser keeps both the table handle and xtables lock until COMMIT.
+    if (sendCommand(type, "*" + table + "\n-S " + parent + "\n", &listing) != 0) {
+        abort();
+        return -EREMOTEIO;
+    }
+    std::string commands;
+    const int result = prepare(listing, &commands);
+    if (result != 0) {
+        abort();
+        return result < 0 ? result : -EINVAL;
+    }
+    // A callback may supply rules/chain declarations only. Keep the single commit
+    // boundary here; malformed framing must not publish a partial transaction.
+    bool valid = commands.find('\0') == std::string::npos &&
+                 commands.find('\r') == std::string::npos &&
+                 (commands.empty() || commands.back() == '\n');
+    for (size_t pos = 0; valid && pos < commands.size();) {
+        const size_t end = commands.find('\n', pos);
+        // Target iptables-restore uses a 10240-byte fgets buffer. Longer physical
+        // lines are split into commands and could smuggle an early COMMIT.
+        valid = end != std::string::npos && end - pos + 1 <= 10239 &&
+                (commands[pos] == '-' || commands[pos] == ':' || commands[pos] == '\n');
+        pos = end + 1;
+    }
+    if (!valid) {
+        abort();
+        return -EINVAL;
+    }
+    std::string output;
+    if (sendCommand(type, commands + "COMMIT\n", &output, false) != 0) {
+        abort();
+        return -EREMOTEIO;
+    }
+    return 0;
+}
