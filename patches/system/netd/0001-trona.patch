diff --git a/server/trona/tag-auth/LegacySocketTagger.cpp b/server/trona/tag-auth/LegacySocketTagger.cpp
new file mode 100644
index 0000000..f930323
--- /dev/null
+++ b/server/trona/tag-auth/LegacySocketTagger.cpp
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "LegacySocketTagger.h"
+#include "client/LegacyQtaguidClient.h"
+
+#include <cerrno>
+#include <climits>
+#include <netinet/in.h>
+#include <sys/socket.h>
+
+namespace trona::network {
+namespace {
+int ValidateLegacySocket(int fd, bool checkTagProtocol) {
+    if (fd < 0) return -EBADF;
+    int family = 0;
+    socklen_t length = sizeof(family);
+    if (getsockopt(fd, SOL_SOCKET, SO_DOMAIN, &family, &length) != 0) return -errno;
+    if (length != sizeof(family)) return -EIO;
+    if (family != AF_INET && family != AF_INET6) return -EAFNOSUPPORT;
+    if (!checkTagProtocol) return 0;
+    int protocol = 0;
+    length = sizeof(protocol);
+    if (getsockopt(fd, SOL_SOCKET, SO_PROTOCOL, &protocol, &length) != 0) return -errno;
+    if (length != sizeof(protocol)) return -EIO;
+    // Preserve the modern backend's restriction for kernels older than 5.10.
+    if (protocol != IPPROTO_TCP && protocol != IPPROTO_UDP) return -EPROTONOSUPPORT;
+    return 0;
+}
+}  // namespace
+
+int TagLegacySocket(int socketFd, uint32_t tag, uint32_t resolvedChargeUid) {
+    if (socketFd < 0) return -EBADF;
+    if (resolvedChargeUid > INT32_MAX) return -EINVAL;
+    // CLAT attribution belongs exclusively to its fixed-purpose coordinator.
+    if (resolvedChargeUid == 1029) return -EPERM;
+    const int checked = ValidateLegacySocket(socketFd, true);
+    if (checked != 0) return checked;
+    return tagSocketFromClient(socketFd, tag, resolvedChargeUid);
+}
+
+int UntagLegacySocket(int socketFd) {
+    // Untag remains available for cleanup independently of tag admission.
+    const int checked = ValidateLegacySocket(socketFd, false);
+    if (checked != 0) return checked;
+    return untagSocketFromClient(socketFd);
+}
+}  // namespace trona::network
