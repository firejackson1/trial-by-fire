+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include "LegacyFirewallRules.h"
+#include <set>
+#include <string>
+
+namespace trona::network {
+// Rebuilds one owned, unhooked chain. Future callers must supply every active user,
+// keep user/admin deny state independently, and attach only on costly interfaces
+// preserving each native hook's quota/policy ordering (shared and per-interface differ).
+// bw_data_saver must already exist with native IPv6 exceptions.
+// This does not implement lifecycle, Data Saver updates, accounting or packet attribution.
+int BuildMeteredUidPolicy(const std::set<int>& users, const std::set<int>& allowed,
+                          const std::set<int>& userDenied, const std::set<int>& adminDenied,
+                          std::string* output,
+                          OwnerAttribution attribution = OwnerAttribution::Unverified);
+}
