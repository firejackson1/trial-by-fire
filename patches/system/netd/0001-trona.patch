+
+namespace trona::network {
+namespace {
+template <typename T> bool decimal(std::string_view text, T* output) {
+    if (text.empty() || text[0] == '-' || text[0] == '+') return false;
+    const auto end = text.data() + text.size();
+    const auto result = std::from_chars(text.data(), end, *output, 10);
+    return result.ec == std::errc{} && result.ptr == end;
+}
+
+template <size_t N> bool fields(const std::string& line, std::array<std::string, N>* values) {
+    std::istringstream stream(line);
+    stream.imbue(std::locale::classic());
+    for (auto& value : *values) if (!(stream >> value)) return false;
+    // Kernel TCP/UDP/other breakdown columns are not part of the returned totals.
+    return true;
+}
+
+bool tag(std::string_view text, int32_t* output, uint64_t* rawOutput) {
+    if (text.size() < 3 || text[0] != '0' || (text[1] != 'x' && text[1] != 'X')) return false;
+    text.remove_prefix(2);
+    uint64_t combined;
+    const auto end = text.data() + text.size();
+    const auto result = std::from_chars(text.data(), end, combined, 16);
+    if (result.ec != std::errc{} || result.ptr != end) return false;
+    // Match NetworkStatsFactory.kernelToTag: upper 32 bits, retaining signed
+    // Android tag bit patterns (for example 0xffffff01 -> -255).
+    const uint32_t upper = combined >> 32;
+    static_assert(sizeof(upper) == sizeof(*output));
+    std::memcpy(output, &upper, sizeof(upper));
+    *rawOutput = combined;
+    return true;
+}
+}  // namespace
+
+int ReadQtaguidStats(std::istream& input, std::vector<QtaguidStatsEntry>* output) {
+    if (!output || input.exceptions() != std::ios::goodbit) return -EINVAL;
+    std::string line;
+    if (!std::getline(input, line)) return input.bad() ? -EIO : -EPROTO;
+    std::array<std::string, 9> values;
+    const std::array<std::string, 9> expected = {"idx", "iface", "acct_tag_hex", "uid_tag_int",
+            "cnt_set", "rx_bytes", "rx_packets", "tx_bytes", "tx_packets"};
+    if (!fields(line, &values) || values != expected) return -EPROTO;
+    uint64_t previous = 1;
+    std::vector<QtaguidStatsEntry> parsed;
+    while (std::getline(input, line)) {
+        if (!fields(line, &values)) return -EPROTO;
+        uint64_t index;
+        QtaguidStatsEntry entry{};
+        if (!decimal(values[0], &index) || previous == UINT64_MAX || index != previous + 1
+                || values[1].empty() || values[1].size() >= 32
+                || values[1].find('\0') != std::string::npos
+                || !tag(values[2], &entry.tag, &entry.rawTag) || !decimal(values[3], &entry.uid)
+                || !decimal(values[4], &entry.set) || !decimal(values[5], &entry.rxBytes)
+                || !decimal(values[6], &entry.rxPackets) || !decimal(values[7], &entry.txBytes)
+                || !decimal(values[8], &entry.txPackets)) return -EPROTO;
+        previous = index;
+        entry.iface = values[1];
+        parsed.push_back(std::move(entry));
+    }
+    if (input.bad() || (!input.eof() && input.fail())) return -EIO;
+    output->swap(parsed);
+    return 0;
+}
+}  // namespace trona::network
+
+namespace trona::network {
+namespace {
+bool ifaceCounters(std::istringstream& row, std::array<int64_t, 4>* counters) {
+    std::string field;
+    for (auto& counter : *counters) {
+        if (!(row >> field) || !decimal(field, &counter)) return false;
+    }
+    return true;
+}
+}  // namespace
+
+int ReadQtaguidIfaceStats(std::istream& input, QtaguidIfaceFormat format,
+                         std::vector<QtaguidStatsEntry>* output) {
+    if (!output || input.exceptions() != std::ios::goodbit
+            || (format != QtaguidIfaceFormat::All && format != QtaguidIfaceFormat::Formatted)) {
+        return -EINVAL;
+    }
+    std::string line;
+    if (format == QtaguidIfaceFormat::Formatted) {
+        if (!std::getline(input, line)) return input.bad() ? -EIO : -EPROTO;
+        std::array<std::string, 5> names;
+        const std::array<std::string, 5> expected = {"ifname", "total_skb_rx_bytes",
+                "total_skb_rx_packets", "total_skb_tx_bytes", "total_skb_tx_packets"};
+        if (!fields(line, &names) || names != expected) return -EPROTO;
+    }
+    std::vector<QtaguidStatsEntry> parsed;
+    while (std::getline(input, line)) {
+        std::istringstream row(line);
+        row.imbue(std::locale::classic());
+        QtaguidStatsEntry entry{};
+        entry.uid = -1;  // NetworkStats.UID_ALL
+        entry.set = -1;  // NetworkStats.SET_ALL
+        if (!(row >> entry.iface) || entry.iface.size() >= 32
+                || entry.iface.find('\0') != std::string::npos) return -EPROTO;
+        int32_t active = 0;
+        if (format == QtaguidIfaceFormat::All) {
+            std::string field;
+            if (!(row >> field) || !decimal(field, &active)) return -EPROTO;
+        }
+        std::array<int64_t, 4> counters;
+        if (!ifaceCounters(row, &counters)) return -EPROTO;
+        if (active != 0) {
+            std::array<int64_t, 4> live;
+            if (!ifaceCounters(row, &live)) return -EPROTO;
+            for (size_t i = 0; i < counters.size(); ++i) {
+                if (live[i] > INT64_MAX - counters[i]) return -EOVERFLOW;
+                counters[i] += live[i];
+            }
+        }
+        // As in the legacy platform reader, ignore extra columns, including
+        // live counters on inactive interfaces. Never add those twice.
+        entry.rxBytes = counters[0];
+        entry.rxPackets = counters[1];
+        entry.txBytes = counters[2];
+        entry.txPackets = counters[3];
+        parsed.push_back(std::move(entry));
+    }
+    if (input.bad() || (!input.eof() && input.fail())) return -EIO;
+    output->swap(parsed);
+    return 0;
+}
+}  // namespace trona::network
diff --git a/server/trona/LegacyQtaguidStats.h b/server/trona/LegacyQtaguidStats.h
new file mode 100644
index 0000000..1fb8a3a
--- /dev/null
+++ b/server/trona/LegacyQtaguidStats.h
@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <cstdint>
+#include <istream>
+#include <string>
+#include <vector>
+
+namespace trona::network {
+// Raw cumulative counters. These are NOT the incremental BPF samples consumed by
+// Android 17 NetworkStatsFactory. No reset/delta, VPN, CLAT, or filtering here.
+struct QtaguidStatsEntry {
+    std::string iface;
+    int32_t uid;
+    int32_t set;
+    int32_t tag;
+    int64_t rxBytes;
+    int64_t rxPackets;
+    int64_t txBytes;
+    int64_t txPackets;
+    // Keep the complete proc tag for consumers (TrafficStats) that test raw
+    // tag zero. NetworkStats uses the separate signed upper-32-bit tag above.
+    uint64_t rawTag = 0;
+};
+
+// Parse the standard xt_qtaguid stats text. Publish a complete result only on
+// success. Return negative errno on malformed input/read failure; never replace
+// the caller's previous data with an empty or partial successful snapshot.
+// An empty, valid header-only snapshot is legitimate. Caller owns/opened the stream
+// and must leave its exception mask disabled (Android builds without exceptions).
+int ReadQtaguidStats(std::istream& input, std::vector<QtaguidStatsEntry>* output);
+
+enum class QtaguidIfaceFormat { All, Formatted };
+
+// Interface totals use UID_ALL/SET_ALL (-1) and TAG_NONE (0). All is the
+// headerless iface_stat_all format: saved counters plus live counters only when
+// active. Formatted is iface_stat_fmt (IP-layer totals with a header).
+// Same stream/error/publication contract as ReadQtaguidStats; no file is opened.
+int ReadQtaguidIfaceStats(std::istream& input, QtaguidIfaceFormat format,
+                         std::vector<QtaguidStatsEntry>* output);
+}  // namespace trona::network
diff --git a/server/trona/MeteredUidController.cpp b/server/trona/MeteredUidController.cpp
new file mode 100644
index 0000000..fc8b463
--- /dev/null
+++ b/server/trona/MeteredUidController.cpp
@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "MeteredUidController.h"
+#include "MeteredUidPolicy.h"
+#include <cerrno>
+
+namespace trona::network {
+namespace {
+int ValidateChain(int id) {
+    if (!FindChain(id)) return -EINVAL;
+    return id >= 10 && id <= 12 ? 0 : -EOPNOTSUPP;
+}
+}
+int MeteredUidController::Commit(State replacement) {
+    std::string command;
+    int result = BuildMeteredUidPolicy(replacement.users, replacement.members[0],
+            replacement.members[1], replacement.members[2], &command, attribution_);
+    if (result) return result; // Invalid input has not changed the kernel or current state.
+    if (!restore_) return -ENOSYS;
+    result = restore_(command);
+    if (result) {
+        // A failure can follow a successful IPv4 update; all three sets are now unknown.
+        state_.reset();
+        return result > 0 ? -EREMOTEIO : result;
+    }
+    state_ = std::move(replacement);
+    return 0;
+}
+int MeteredUidController::ReplacePolicy(const std::set<int>& users, const std::set<int>& allowed,
+        const std::set<int>& userDenied, const std::set<int>& adminDenied) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return Commit(State{users, {allowed, userDenied, adminDenied}});
+}
+int MeteredUidController::SetUidRule(int id, int uid, int rule) {
+    int result = ValidateChain(id);
+    if (result) return result;
+    if (uid < 0 || (rule != 1 && rule != 2)) return -EINVAL;
+    if (attribution_ != OwnerAttribution::VerifiedQtaguid) return -EOPNOTSUPP;
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!state_) return -EAGAIN;
+    bool member = id == 10 ? rule == 1 : rule == 2;
+    if ((state_->members[id - 10].count(uid) != 0) == member) return 0;
+    State replacement = *state_;
+    if (member) replacement.members[id - 10].insert(uid);
+    else replacement.members[id - 10].erase(uid);
+    return Commit(std::move(replacement));
+}
+int MeteredUidController::GetUidRule(int id, int uid, int* rule) {
+    int result = ValidateChain(id);
+    if (result) return result;
+    if (uid < 0 || !rule) return -EINVAL;
+    if (attribution_ != OwnerAttribution::VerifiedQtaguid) return -EOPNOTSUPP;
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!state_) return -EAGAIN;
+    bool member = state_->members[id - 10].count(uid) != 0;
+    *rule = member == (id == 10) ? 1 : 2;
+    return 0;
+}
+int MeteredUidController::RemoveUid(int uid) {
+    if (uid < 0) return -EINVAL;
+    if (attribution_ != OwnerAttribution::VerifiedQtaguid) return -EOPNOTSUPP;
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!state_) return -EAGAIN;
+    State replacement = *state_;
+    bool changed = false;
+    for (auto& members : replacement.members) changed |= members.erase(uid) != 0;
+    return changed ? Commit(std::move(replacement)) : 0;
+}
+}
diff --git a/server/trona/MeteredUidController.h b/server/trona/MeteredUidController.h
new file mode 100644
index 0000000..51b03fd
--- /dev/null
+++ b/server/trona/MeteredUidController.h
@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include "LegacyFirewallRules.h"
+#include <array>
+#include <functional>
+#include <mutex>
+#include <optional>
+#include <set>
+#include <string>
+#include <utility>
+
+namespace trona::network {
+// Owns membership for one unhooked metered policy chain. The caller must replay
+// complete policy on startup or after ANY restore failure before enabling hooks.
+// Restore must preserve other chains, apply IPv4+IPv6, and never throw or reenter.
+// Other writers must not mutate this owned chain while its cached state is used.
+// No interface hooks, Data Saver lifecycle, persistence or attribution probe here.
+class MeteredUidController {
+public:
+    using Restore = std::function<int(const std::string&)>;
+    explicit MeteredUidController(Restore restore,
+            OwnerAttribution attribution = OwnerAttribution::Unverified)
+        : restore_(std::move(restore)), attribution_(attribution) {}
+    int ReplacePolicy(const std::set<int>& users, const std::set<int>& allowed,
+                      const std::set<int>& userDenied, const std::set<int>& adminDenied);
+    int SetUidRule(int chain, int uid, int rule);
+    // Reports explicit membership, not an effective packet decision or core exemption.
+    int GetUidRule(int chain, int uid, int* rule);
+    int RemoveUid(int uid);
+private:
+    struct State {
+        std::set<int> users;
+        // Android 17 chain IDs 10, 11, 12: allow, user deny, admin deny.
+        std::array<std::set<int>, 3> members;
+    };
+    int Commit(State replacement); // mutex_ held; publishes only after successful restore.
+    Restore restore_;
+    const OwnerAttribution attribution_;
+    std::mutex mutex_;
+    std::optional<State> state_;
+};
+}
diff --git a/server/trona/MeteredUidPolicy.cpp b/server/trona/MeteredUidPolicy.cpp
new file mode 100644
index 0000000..8c4c999
--- /dev/null
+++ b/server/trona/MeteredUidPolicy.cpp
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "MeteredUidPolicy.h"
+#include <cerrno>
+#include <utility>
+
+namespace trona::network {
+int BuildMeteredUidPolicy(const std::set<int>& users, const std::set<int>& allowed,
+                          const std::set<int>& userDenied, const std::set<int>& adminDenied,
+                          std::string* output, OwnerAttribution attribution) {
+    if (!output) return -EINVAL;
+    output->clear();
+    if (!users.count(0)) return -EINVAL;
+    for (int user : users) if (user < 0 || user > 21474) return -EINVAL;
+    for (const auto* members : {&allowed, &userDenied, &adminDenied}) {
+        for (int uid : *members) if (uid < 0) return -EINVAL;
+    }
+    if (attribution != OwnerAttribution::VerifiedQtaguid) return -EOPNOTSUPP;
+
+    std::set<int> denied = userDenied;
+    denied.insert(adminDenied.begin(), adminDenied.end());
+    const std::string append = "-A tr_metered ";
+    std::string command = "*filter\n:tr_metered -\n-F tr_metered\n";
+    // Unlike nonmetered firewall policy, explicit denial precedes core UID exemptions.
+    for (int uid : denied) {
+        command += append + "-m owner --uid-owner " + std::to_string(uid) + " -j REJECT\n";
+    }
+    // The target BPF matcher exposes ownerless packets as overflow UID 65534.
+    // This equivalence must be proven on the retained qtaguid provider before use.
+    command += append + "-m owner ! --uid-owner 0-4294967294 -j " +
+               (denied.count(65534) ? "REJECT\n" : "RETURN\n");
+    command += append + "-m owner --uid-owner 65534 -j RETURN\n";
+    for (int user : users) {
+        const long long first = static_cast<long long>(user) * 100000;
+        command += append + "-m owner --uid-owner " + std::to_string(first) + "-" +
+                   std::to_string(first + 9999) + " -j RETURN\n";
+    }
+    for (int uid : allowed) {
+        command += append + "-m owner --uid-owner " + std::to_string(uid) + " -j RETURN\n";
+    }
+    // Keep Data Saver's native IPv6-critical rules; do not replace them with a raw DROP.
+    command += append + "-j bw_data_saver\nCOMMIT\n";
+    *output = std::move(command);
+    return 0;
+}
+}
