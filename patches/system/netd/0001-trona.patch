--- /dev/null
+++ b/server/trona/tag-auth/client/LegacyQtaguidClient.cpp
@@ -0,0 +1,95 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "LegacyQtaguidClient.h"
+
+#include <cerrno>
+#include <cinttypes>
+#include <cstdio>
+#include <fcntl.h>
+#include <pthread.h>
+#include <unistd.h>
+
+#ifndef TRONA_QTAGUID_TRACK_PATH
+#define TRONA_QTAGUID_TRACK_PATH "/dev/xt_qtaguid"
+#endif
+#ifndef TRONA_QTAGUID_CTRL_PATH
+#define TRONA_QTAGUID_CTRL_PATH "/proc/net/xt_qtaguid/ctrl"
+#endif
+
+namespace trona::network {
+namespace {
+pthread_mutex_t trackerMutex = PTHREAD_MUTEX_INITIALIZER;
+pthread_once_t forkRegistration = PTHREAD_ONCE_INIT;
+int trackerFd = -1;
+int forkRegistrationError = 0;
+
+void beforeFork() { pthread_mutex_lock(&trackerMutex); }
+void afterParentFork() { pthread_mutex_unlock(&trackerMutex); }
+void afterChildFork() {
+    // A child must not use the parent's tracking file description. Its first tag
+    // opens a tracker owned by the child's process.
+    if (trackerFd >= 0) close(trackerFd);
+    trackerFd = -1;
+    pthread_mutex_unlock(&trackerMutex);
+}
+void registerForkHandlers() {
+    forkRegistrationError = pthread_atfork(beforeFork, afterParentFork, afterChildFork);
+}
+
+int ensureTracked() {
+    int result = pthread_once(&forkRegistration, registerForkHandlers);
+    if (result != 0) return -result;
+    if (forkRegistrationError != 0) return -forkRegistrationError;
+    result = pthread_mutex_lock(&trackerMutex);
+    if (result != 0) return -result;
+    if (trackerFd < 0) {
+        do {
+            trackerFd = open(TRONA_QTAGUID_TRACK_PATH, O_RDONLY | O_CLOEXEC);
+        } while (trackerFd < 0 && errno == EINTR);
+        if (trackerFd < 0) result = -errno;
+    }
+    const int unlock = pthread_mutex_unlock(&trackerMutex);
+    if (result == 0 && unlock != 0) result = -unlock;
+    return result;
+}
+
+int writeControl(const char* command, size_t size) {
+    int fd;
+    do {
+        fd = open(TRONA_QTAGUID_CTRL_PATH, O_WRONLY | O_CLOEXEC);
+    } while (fd < 0 && errno == EINTR);
+    if (fd < 0) return -errno;
+    ssize_t written;
+    do {
+        written = write(fd, command, size);
+    } while (written < 0 && errno == EINTR);
+    // A proc command is one transaction. A partial write cannot be retried as a suffix.
+    const int error = written < 0 ? errno : (static_cast<size_t>(written) == size ? 0 : EIO);
+    close(fd);
+    return -error;
+}
+}
+
+int tagSocketFromClient(int socketFd, uint32_t tag, uid_t uid) {
+    if (socketFd < 0) return -EBADF;
+    const int tracked = ensureTracked();
+    if (tracked != 0) return tracked;
+    char command[96];
+    const auto rawTag = static_cast<uint64_t>(tag) << 32;
+    // -1 means the caller's UID. Omitting the UID lets the kernel use
+    // current_fsuid; formatting -1 as an unsigned UID would fail permission checks.
+    const int size = uid == static_cast<uid_t>(-1)
+            ? snprintf(command, sizeof(command), "t %d %" PRIu64, socketFd, rawTag)
+            : snprintf(command, sizeof(command), "t %d %" PRIu64 " %u", socketFd,
+                       rawTag, uid);
+    if (size < 0 || static_cast<size_t>(size) >= sizeof(command)) return -EOVERFLOW;
+    return writeControl(command, static_cast<size_t>(size));
+}
+
+int untagSocketFromClient(int socketFd) {
+    if (socketFd < 0) return -EBADF;
+    char command[32];
+    const int size = snprintf(command, sizeof(command), "u %d", socketFd);
+    if (size < 0 || static_cast<size_t>(size) >= sizeof(command)) return -EOVERFLOW;
+    return writeControl(command, static_cast<size_t>(size));
+}
+}
