+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include "RetainedNetworkPrerequisites.h"
+#include <trona/NativeNetworkProfile.h>
+#include <string>
+namespace trona::network {
+enum class RetainedText { KernelRelease, BootSerial, Stats, IfaceAll, IfaceFormatted,
+    Matches4, Matches6, Tables4, Tables6, Targets4, Targets6, RestoreHelp4, RestoreHelp6 };
+// Fixed-purpose injected boundary for host checks; production supplies only the
+// fixed paths and --help/--test operations below, never arbitrary commands.
+struct RetainedPrerequisiteProbe {
+    int (*requested)(RequestedNetworkBackend*, void*) noexcept;
+    int (*read)(RetainedText, std::string*, void*) noexcept;
+    int (*controlOpen)(void*) noexcept;
+    int (*trackerOpen)(void*) noexcept;
+    int (*restoreTest)(bool ipv6, const std::string&, void*) noexcept;
+    void* context;
+};
+int VerifyRetainedNetworkPrerequisitesWithProbe(const RetainedPrerequisiteProbe&,
+                                               OwnerAttribution*) noexcept;
+}  // namespace trona::network
diff --git a/server/trona/UidRuleController.cpp b/server/trona/UidRuleController.cpp
new file mode 100644
index 0000000..463f7d0
--- /dev/null
+++ b/server/trona/UidRuleController.cpp
@@ -0,0 +1,157 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "UidRuleController.h"
+#include "LegacyFirewallRules.h"
+#include <cerrno>
+namespace trona::network {
+namespace {
+int ValidateChain(int id) {
+    const Chain* chain = FindChain(id);
+    return !chain ? -EINVAL : chain->metered ? -EOPNOTSUPP : 0;
+}
+int NormalizeResult(int result) { return result > 0 ? -EREMOTEIO : result; }
+std::string ChainBody(int id, const std::set<int>& members) {
+    const Chain* chain = FindChain(id);
+    std::string body = std::string(":") + chain->name + " -\n-F " + chain->name + "\n";
+    for (int uid : members) {
+        body += std::string("-A ") + chain->name + " -m owner --uid-owner " +
+                std::to_string(uid) + " -j " + (chain->allowlist ? "RETURN\n" : "DROP\n");
+    }
+    if (chain->allowlist) body += std::string("-A ") + chain->name + " -j DROP\n";
+    return body;
+}
+int DispatchBody(const std::set<int>& users, const std::set<int>& enabled,
+                 OwnerAttribution attribution, std::string* output) {
+    output->clear();
+    const std::string header = "*filter\n", footer = "COMMIT\n";
+    for (Direction direction : {Direction::Ingress, Direction::Egress}) {
+        std::string section;
+        int result = BuildPacketDispatch(direction, users, enabled, &section, attribution);
+        if (result) return result;
+        // Merge only our own generator's filter sections into the caller's transaction.
+        if (section.size() < header.size() + footer.size() ||
+            section.compare(0, header.size(), header) != 0 ||
+            section.compare(section.size() - footer.size(), footer.size(), footer) != 0)
+            return -EPROTO;
+        output->append(section, header.size(), section.size() - header.size() - footer.size());
+    }
+    return 0;
+}
+}
+int UidRuleController::InitializeEmptyChain(int id) {
+    return ReplaceUidChain(id, {});
+}
+int UidRuleController::ReplaceUidChain(int id, const std::vector<int>& members) {
+    int result = ValidateChain(id);
+    if (result) return result;
+    State replacement;
+    for (int uid : members) {
+        if (uid < 0) return -EINVAL;
+        replacement.members.insert(uid);
+    }
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (ownsDispatch_ && !dispatch_) return -EAGAIN;
+    if (!restore_) return -ENOSYS;
+    std::string command = "*filter\n" + ChainBody(id, replacement.members) + "COMMIT\n";
+    result = NormalizeResult(restore_(command));
+    if (result) InvalidateAfterFailure(id);
+    else states_[id] = std::move(replacement);
+    return result;
+}
+int UidRuleController::SetUidRule(int id, int uid, int rule) {
+    std::string command;
+    int result = BuildUidRuleUpdate(id, uid, rule, &command);
+    if (result) return result;
+    std::lock_guard<std::mutex> lock(mutex_);
+    auto state = states_.find(id);
+    if (state == states_.end()) return -EAGAIN;
+    bool member = FindChain(id)->allowlist ? rule == 1 : rule == 2;
+    if ((state->second.members.count(uid) != 0) == member) return 0;
+    result = NormalizeResult(restore_(command));
+    if (result) {
+        // IPv4 may have changed even when IPv6 failed. Never reuse an assumed state.
+        InvalidateAfterFailure(id);
+        return result;
+    }
+    if (member) state->second.members.insert(uid);
+    else state->second.members.erase(uid);
+    return 0;
+}
+int UidRuleController::GetUidRule(int id, int uid, int* rule) {
+    int result = ValidateChain(id);
+    if (result) return result;
+    if (uid < 0 || !rule) return -EINVAL;
+    std::lock_guard<std::mutex> lock(mutex_);
+    auto state = states_.find(id);
+    if (state == states_.end()) return -EAGAIN;
+    bool member = state->second.members.count(uid) != 0;
+    *rule = member == FindChain(id)->allowlist ? 1 : 2;
+    return 0;
+}
+void UidRuleController::InvalidateAfterFailure(int id) {
+    if (ownsDispatch_) {
+        states_.clear();
+        dispatch_.reset();
+    } else {
+        states_.erase(id);
+    }
+}
+int UidRuleController::ReplayPolicy(const std::set<int>& users,
+                                  const std::map<int, std::vector<int>>& members,
+                                  const std::set<int>& enabled) {
+    std::map<int, State> replacement;
+    for (const auto& [id, uids] : members) {
+        int result = ValidateChain(id);
+        if (result) return result;
+        auto& target = replacement[id].members;
+        for (int uid : uids) {
+            if (uid < 0) return -EINVAL;
+            target.insert(uid);
+        }
+    }
+    // Nine distinct validated IDs imply the complete current nonmetered chain set.
+    if (replacement.size() != 9) return -EINVAL;
+    std::string dispatchBody;
+    int result = DispatchBody(users, enabled, attribution_, &dispatchBody);
+    if (result) return result;
+    std::string command = "*filter\n";
+    for (const auto& [id, state] : replacement) command += ChainBody(id, state.members);
+    command += dispatchBody + "COMMIT\n";
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!restore_) return -ENOSYS;
+    ownsDispatch_ = true;
+    result = NormalizeResult(restore_(command));
+    if (result) {
+        InvalidateAfterFailure(0);
+        return result;
+    }
+    states_ = std::move(replacement);
+    dispatch_ = Dispatch{users, enabled};
+    return 0;
+}
+int UidRuleController::SetChildChain(int id, bool enabled) {
+    int result = ValidateChain(id);
+    if (result) return result;
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!dispatch_) return -EAGAIN;
+    if ((dispatch_->enabled.count(id) != 0) == enabled) return 0;
+    auto replacement = dispatch_->enabled;
+    if (enabled) replacement.insert(id);
+    else replacement.erase(id);
+    std::string body;
+    result = DispatchBody(dispatch_->users, replacement, attribution_, &body);
+    if (result) return result;
+    result = NormalizeResult(restore_("*filter\n" + body + "COMMIT\n"));
+    if (result) InvalidateAfterFailure(id);
+    else dispatch_->enabled = std::move(replacement);
+    return result;
+}
+int UidRuleController::GetChildChainEnabled(int id, bool* enabled) {
+    int result = ValidateChain(id);
+    if (result) return result;
+    if (!enabled) return -EINVAL;
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!dispatch_) return -EAGAIN;
+    *enabled = dispatch_->enabled.count(id) != 0;
+    return 0;
+}
+}
diff --git a/server/trona/UidRuleController.h b/server/trona/UidRuleController.h
new file mode 100644
index 0000000..6fa7e97
--- /dev/null
+++ b/server/trona/UidRuleController.h
@@ -0,0 +1,50 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include "LegacyFirewallRules.h"
+#include <functional>
+#include <map>
+#include <mutex>
+#include <optional>
+#include <set>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace trona::network {
+// Owns nonmetered membership and optional unhooked packet dispatch. Native Controllers
+// owns top-level hooks; metered policy, persistence and framework routing are separate.
+// Restore must not throw, must preserve unrelated rules and apply IPv4+IPv6, and must
+// never reenter this controller. The eventual Android executor uses errno returns.
+// Other writers must not modify these chains; after native reset, discard this instance
+// and replay an authoritative complete snapshot before enabling hooks.
+class UidRuleController {
+public:
+    using Restore = std::function<int(const std::string&)>;
+    explicit UidRuleController(Restore restore,
+            OwnerAttribution attribution = OwnerAttribution::Unverified)
+        : restore_(std::move(restore)), attribution_(attribution) {}
+    int InitializeEmptyChain(int chain);
+    // Replaces membership completely; duplicates are normalized before execution.
+    int ReplaceUidChain(int chain, const std::vector<int>& members);
+    int SetUidRule(int chain, int uid, int rule);
+    int GetUidRule(int chain, int uid, int* rule);
+    // Requires explicit membership for ALL nine nonmetered chains and verified attribution.
+    // Rebuilds membership and both dispatch directions in one filter transaction per family.
+    // Once used, ANY restore failure requires complete replay, never a partial chain reset.
+    int ReplayPolicy(const std::set<int>& users,
+                     const std::map<int, std::vector<int>>& members,
+                     const std::set<int>& enabled);
+    int SetChildChain(int chain, bool enabled);
+    int GetChildChainEnabled(int chain, bool* enabled);
+private:
+    struct State { std::set<int> members; };
+    struct Dispatch { std::set<int> users; std::set<int> enabled; };
+    void InvalidateAfterFailure(int chain); // mutex_ held
+    Restore restore_;
+    const OwnerAttribution attribution_;
+    std::mutex mutex_;
+    std::map<int, State> states_;
+    bool ownsDispatch_ = false;
+    std::optional<Dispatch> dispatch_;
+};
+}
diff --git a/server/trona/tag-auth/LegacyNativeTagAdapters.cpp b/server/trona/tag-auth/LegacyNativeTagAdapters.cpp
new file mode 100644
index 0000000..c7efdd0
--- /dev/null
+++ b/server/trona/tag-auth/LegacyNativeTagAdapters.cpp
@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "LegacyNativeTagAdapters.h"
+#include "LegacyTagPermissionOracle.h"
+#include "LegacySocketTagger.h"
+
+namespace trona::network {
+namespace {
+class Oracle final : public LegacyTagPermissionQuery {
+    int check(AuthenticatedTagPeer peer) noexcept override {
+        return QueryUpdateDeviceStatsPermission(peer.pid, peer.uid);
+    }
+};
+class Action final : public LegacySocketTagger {
+    int tag(int fd, uint32_t value, uint32_t uid) noexcept override {
+        return TagLegacySocket(fd, value, uid);
+    }
+};
+}  // namespace
+
+std::shared_ptr<LegacyTagDispatcher> CreateLegacyNativeTagDispatcher(int* error) noexcept {
+    auto dispatcher = LegacyTagDispatcher::create(
+            std::make_shared<Oracle>(), std::make_shared<Action>(), error);
+    return std::shared_ptr<LegacyTagDispatcher>(std::move(dispatcher));
+}
+}  // namespace trona::network
