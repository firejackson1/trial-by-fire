+::android::binder::Status OemNetdListener::getTronaUidBlockedStatus(
+        int32_t uid, TronaUidBlockedStatus* blockedStatus) {
+    auto permission = checkAnyPermission({PERM_NETWORK_STACK, PERM_MAINLINE_NETWORK_STACK});
+    if (!permission.isOk()) return permission;
+    if (!mTronaUidController || !mTronaMeteredController || !mTronaBandwidthController) {
+        return statusFromErrcode(-EOPNOTSUPP);
+    }
+    if (uid < 0 || !blockedStatus) return statusFromErrcode(-EINVAL);
+    TronaUidBlockedStatus result;
+    for (int chain = 1; chain <= 9; ++chain) {
+        bool enabled;
+        if (int error = mTronaUidController->GetChildChainEnabled(chain, &enabled)) {
+            return statusFromErrcode(error);
+        }
+        if (enabled) result.enabledChains.push_back(chain);
+        int rule;
+        if (int error = mTronaUidController->GetUidRule(chain, uid, &rule)) {
+            return statusFromErrcode(error);
+        }
+        if (rule != 1 && rule != 2) return statusFromErrcode(-EIO);
+        if (rule == 2) result.deniedChains.push_back(chain);
+    }
+    for (int chain = 10; chain <= 12; ++chain) {
+        int rule;
+        if (int error = mTronaMeteredController->GetUidRule(chain, uid, &rule)) {
+            return statusFromErrcode(error);
+        }
+        if (rule != 1 && rule != 2) return statusFromErrcode(-EIO);
+        if (rule == 2) result.deniedChains.push_back(chain);
+    }
+    {
+        std::lock_guard guard(mTronaBandwidthController->lock);
+        if (int error = mTronaBandwidthController->getDataSaverEnabled(&result.dataSaverEnabled)) {
+            return statusFromErrcode(error);
+        }
+    }
+    // Publish only a complete successful observation; never an empty fallback.
+    *blockedStatus = std::move(result);
+    return ::android::binder::Status::ok();
+}
