new file mode 100644
index 0000000..e6202eb
--- /dev/null
+++ b/server/trona/LegacyFirewallRules.cpp
@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "LegacyFirewallRules.h"
+#include <cerrno>
+
+namespace trona::network {
+namespace {
+constexpr Chain chains[] = {
+    {1, "fw_dozable", true, false},
+    {2, "fw_standby", false, false},
+    {3, "fw_powersave", true, false},
+    {4, "fw_restricted", true, false},
+    {5, "fw_low_power_standby", true, false},
+    {6, "fw_background", true, false},
+    {7, "fw_oem_deny_1", false, false},
+    {8, "fw_oem_deny_2", false, false},
+    {9, "fw_oem_deny_3", false, false},
+    {10, "fw_metered_allow", true, true},
+    {11, "fw_metered_deny_user", false, true},
+    {12, "fw_metered_deny_admin", false, true},
+};
+}
+const Chain* FindChain(int id) {
+    for (const auto& chain : chains) {
+        if (chain.id == id) return &chain;
+    }
+    return nullptr;
+}
+int BuildUidRuleUpdate(int id, int uid, int rule, std::string* output) {
+    if (!output) return -EINVAL;
+    output->clear();
+    const Chain* chain = FindChain(id);
+    if (!chain || uid < 0 || (rule != 1 && rule != 2)) return -EINVAL;
+    if (chain->metered) return -EOPNOTSUPP;
+    const char* operation = chain->allowlist ? (rule == 1 ? "-I" : "-D")
+                                           : (rule == 2 ? "-A" : "-D");
+    const char* target = chain->allowlist ? "RETURN" : "DROP";
+    *output = std::string("*filter\n") + operation + " " + chain->name +
+              " -m owner --uid-owner " + std::to_string(uid) + " -j " + target + "\nCOMMIT\n";
+    return 0;
+}
+int BuildPacketDispatch(Direction direction, const std::set<int>& users,
+                        const std::set<int>& enabled, std::string* output,
+                        OwnerAttribution attribution) {
+    if (!output) return -EINVAL;
+    output->clear();
+    if ((direction != Direction::Ingress && direction != Direction::Egress) || !users.count(0))
+        return -EINVAL;
+    for (int user : users) if (user < 0 || user > 21474) return -EINVAL;
+    for (int id : enabled) {
+        const Chain* chain = FindChain(id);
+        if (!chain) return -EINVAL;
+        if (chain->metered) return -EOPNOTSUPP;
+    }
+    if (attribution != OwnerAttribution::VerifiedQtaguid) return -EOPNOTSUPP;
+    const bool ingress = direction == Direction::Ingress;
+    const std::string parent = ingress ? "tr_uid_in" : "tr_uid_out";
+    const std::string append = "-A " + parent + " ";
+    std::string command = "*filter\n:" + parent + " -\n-F " + parent + "\n";
+    command += append + "-m owner ! --uid-owner 0-4294967294 -j RETURN\n";
+    command += append + "-m owner --uid-owner 65534 -j RETURN\n";
+    for (int user : users) {
+        long long first = static_cast<long long>(user) * 100000;
+        command += append + "-m owner --uid-owner " + std::to_string(first) + "-" +
+                   std::to_string(first + 9999) + " -j RETURN\n";
+    }
+    command += append + "-p esp -j RETURN\n";
+    command += append + "-p tcp --tcp-flags RST RST -j RETURN\n";
+    if (ingress) command += append + "-p tcp --tcp-flags FIN FIN -j RETURN\n";
+    for (int id : enabled) {
+        command += append;
+        if (id == 6) command += ingress ? "! -i lo " : "! -o lo ";
+        command += std::string("-j ") + FindChain(id)->name + "\n";
+    }
+    *output = command + "COMMIT\n";
+    return 0;
+}
+}
diff --git a/server/trona/LegacyFirewallRules.h b/server/trona/LegacyFirewallRules.h
new file mode 100644
index 0000000..3ea1eaf
--- /dev/null
+++ b/server/trona/LegacyFirewallRules.h
@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <string>
+#include <set>
+
+namespace trona::network {
+struct Chain {
+    int id;
+    const char* name;
+    bool allowlist;
+    bool metered;
+};
+const Chain* FindChain(int id);
+// Compile one UID mutation for the IPv4+IPv6 restore boundary. No commands execute here.
+// This primitive is NOT an idempotent setUidRule API: the controller must reconcile state
+// or replace complete chains. Replaying additions can create duplicate iptables rules.
+// Metered chains require their separate interface-aware backend and return EOPNOTSUPP.
+int BuildUidRuleUpdate(int chain, int uid, int rule, std::string* output);
+enum class Direction { Ingress, Egress };
+enum class OwnerAttribution { Unverified, VerifiedQtaguid };
+// Generates unhooked packet-dispatch chains only; not socket-creation permission policy.
+int BuildPacketDispatch(Direction direction, const std::set<int>& users,
+                        const std::set<int>& enabled, std::string* output,
+                        OwnerAttribution attribution = OwnerAttribution::Unverified);
+}
