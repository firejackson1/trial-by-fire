diff --git a/server/trona/RetainedNetworkPrerequisites.cpp b/server/trona/RetainedNetworkPrerequisites.cpp
new file mode 100644
index 0000000..b054a60
--- /dev/null
+++ b/server/trona/RetainedNetworkPrerequisites.cpp
@@ -0,0 +1,118 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "RetainedNetworkPrerequisitesProbe.h"
+#include "RetainedNetworkEvidence.h"
+#include "LegacyQtaguidStats.h"
+#include <algorithm>
+#include <cerrno>
+#include <charconv>
+#include <set>
+#include <sstream>
+#include <string_view>
+#include <vector>
+
+namespace trona::network {
+namespace {
+constexpr size_t kMaxProcBytes = 4 * 1024 * 1024;
+int status(int value) { return value > 0 ? -EIO : value; }
+std::vector<std::string> words(const std::string& line) {
+    std::istringstream stream(line); std::vector<std::string> result;
+    for (std::string word; stream >> word;) result.push_back(word);
+    return result;
+}
+bool number(const std::string& value) {
+    if (value.empty() || value[0] == '+' || value[0] == '-') return false;
+    uint64_t parsed; auto result = std::from_chars(value.data(), value.data()+value.size(), parsed);
+    return result.ec == std::errc{} && result.ptr == value.data()+value.size();
+}
+int snapshot(const RetainedPrerequisiteProbe& p, RetainedText input, std::string* text) {
+    int result = status(p.read(input, text, p.context)); if (result) return result;
+    if (text->size() > kMaxProcBytes) return -EFBIG;
+    if (text->find('\0') != std::string::npos) return -EINVAL;
+    return 0;
+}
+int exactRows(const std::string& text, const char* header, size_t columns,
+              bool detailed) {
+    // The headerless interface table can legitimately have no entries before
+    // NETDEV_UP/address notification. Header-bearing formats must retain theirs.
+    if (text.empty()) return header ? -EPROTO : 0;
+    if (text.back() != '\n') return -EPROTO;
+    std::istringstream stream(text); std::string line;
+    if (header && (!std::getline(stream,line) || words(line) != words(header))) return -EPROTO;
+    while (std::getline(stream,line)) {
+        auto row = words(line); if (row.size() != columns) return -EPROTO;
+        for (size_t i = detailed ? 0 : 1; i < row.size(); ++i) {
+            if (detailed && (i == 1 || i == 2)) continue;
+            if (!number(row[i])) return -EINVAL;
+        }
+    }
+    return stream.bad() ? -EIO : 0;
+}
+bool has(const std::string& text, std::initializer_list<const char*> required) {
+    auto tokens = words(text); std::set<std::string> values(tokens.begin(),tokens.end());
+    for (const auto* token : required) if (!values.count(token)) return false;
+    return true;
+}
+}  // namespace
+
+int VerifyRetainedNetworkPrerequisitesWithProbe(const RetainedPrerequisiteProbe& p,
+                                               OwnerAttribution* out) noexcept {
+    if (!out || !p.requested || !p.read || !p.controlOpen || !p.trackerOpen || !p.restoreTest) return -EINVAL;
+    RequestedNetworkBackend backend;
+    int result = status(p.requested(&backend,p.context)); if (result) return result;
+    // The shared frozen selector validates the trona vendor identity for legacy.
+    if (backend != RequestedNetworkBackend::TronaLegacy) return -EOPNOTSUPP;
+    std::string text;
+    if ((result = snapshot(p,RetainedText::KernelRelease,&text))) return result;
+    if (text != kRetainedMeasuredKernel) return -EOPNOTSUPP;
+    if ((result = snapshot(p,RetainedText::BootSerial,&text))) return result;
+    if (text != kRetainedVendorDevice) return -ENODEV;
+    std::vector<QtaguidStatsEntry> rows;
+    if ((result = snapshot(p,RetainedText::Stats,&text))) return result;
+    if ((result = exactRows(text,kRetainedStatsHeader,21,true))) return result;
+    std::istringstream stats(text);
+    if ((result = ReadQtaguidStats(stats,&rows))) return result;
+    if ((result = snapshot(p,RetainedText::IfaceAll,&text))) return result;
+    if ((result = exactRows(text,nullptr,10,false))) return result;
+    const bool ifaceTableEmpty = text.empty();
+    std::istringstream all(text);
+    if ((result = ReadQtaguidIfaceStats(all,QtaguidIfaceFormat::All,&rows))) return result;
+    if ((result = snapshot(p,RetainedText::IfaceFormatted,&text))) return result;
+    // The kernel writes this header in seq start, and seq_read discards it when
+    // the interface list has no record: the state before "ifup lo" in on boot.
+    if (!ifaceTableEmpty || !text.empty()) {
+        if ((result = exactRows(text,kRetainedIfaceHeader,17,false))) return result;
+        std::istringstream formatted(text);
+        if ((result = ReadQtaguidIfaceStats(formatted,QtaguidIfaceFormat::Formatted,&rows))) return result;
+    }
+    for (auto input : {RetainedText::Matches4,RetainedText::Matches6}) {
+        if ((result = snapshot(p,input,&text))) return result;
+        if (!has(text,{"owner","quota2","policy","mark","comment","conntrack"})) return -EOPNOTSUPP;
+    }
+    for (auto input : {RetainedText::Tables4,RetainedText::Tables6}) {
+        if ((result = snapshot(p,input,&text))) return result;
+        if (!has(text,{"filter","raw","mangle"}) ||
+            (input == RetainedText::Tables4 && !has(text,{"nat"}))) return -EOPNOTSUPP;
+    }
+    for (auto input : {RetainedText::Targets4,RetainedText::Targets6}) {
+        if ((result = snapshot(p,input,&text))) return result;
+        if (!has(text,{"MARK","REJECT","CONNMARK"})) return -EOPNOTSUPP;
+    }
+    if ((result = status(p.controlOpen(p.context)))) return result;
+    if ((result = status(p.trackerOpen(p.context)))) return result;
+    for (auto input : {RetainedText::RestoreHelp4,RetainedText::RestoreHelp6}) {
+        if ((result = snapshot(p,input,&text))) return result;
+        if (!has(text,{"--test","--noflush"})) return -EOPNOTSUPP;
+        const auto options = words(text);
+        if (!std::any_of(options.begin(),options.end(),[](const auto& option) {
+                return option == "--wait" || option.compare(0,7,"--wait=") == 0;
+            })) return -EOPNOTSUPP;
+    }
+    for (bool ipv6 : {false,true}) {
+        if ((result = status(p.restoreTest(ipv6,kRetainedRestoreInput,p.context)))) return result;
+    }
+    // This is the pinned measured retained-kernel acceptance, not a deduction
+    // that mere registry entries or --test prove packet/kernel checkentry behavior.
+    *out = OwnerAttribution::VerifiedQtaguid;
+    return 0;
+}
+}  // namespace trona::network
diff --git a/server/trona/RetainedNetworkPrerequisites.h b/server/trona/RetainedNetworkPrerequisites.h
