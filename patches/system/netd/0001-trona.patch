@@ -0,0 +1,10 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include "LegacyFirewallRules.h"
+namespace trona::network {
+// Narrow bring-up acceptance for the pinned development serial/retained kernel.
+// Success relies on the separately pinned measured owner evidence; these runtime
+// reads/parser tests alone are not packet attribution or Android17 proof.
+// Zero publishes VerifiedQtaguid; negative errno leaves *out untouched.
+int VerifyRetainedNetworkPrerequisites(OwnerAttribution* out) noexcept;
+}  // namespace trona::network
diff --git a/server/trona/RetainedNetworkPrerequisitesIo.cpp b/server/trona/RetainedNetworkPrerequisitesIo.cpp
new file mode 100644
index 0000000..a19992f
--- /dev/null
+++ b/server/trona/RetainedNetworkPrerequisitesIo.cpp
@@ -0,0 +1,176 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "RetainedNetworkPrerequisitesProbe.h"
+#include "RetainedNetworkEvidence.h"
+#include <android-base/properties.h>
+#include <algorithm>
+#include <cerrno>
+#include <chrono>
+#include <csignal>
+#include <cstring>
+#include <fcntl.h>
+#include <poll.h>
+#include <spawn.h>
+#include <sys/stat.h>
+#include <sys/utsname.h>
+#include <sys/wait.h>
+#include <unistd.h>
+extern char** environ;
+
+namespace trona::network {
+namespace {
+constexpr size_t kMaxProcBytes = 4 * 1024 * 1024;
+constexpr size_t kMaxCommandOutput = 64 * 1024;
+constexpr int kCommandDeadlineMs = 5000;
+struct Fd {
+    int fd = -1;
+    explicit Fd(int value = -1) : fd(value) {}
+    ~Fd() { if (fd >= 0) close(fd); }
+    void reset() { if (fd >= 0) close(fd); fd = -1; }
+};
+int readFile(const char* path, std::string* out) {
+    Fd fd(open(path,O_RDONLY|O_CLOEXEC|O_NOFOLLOW));
+    if (fd.fd < 0) return -errno;
+    std::string value; char buffer[4096];
+    for (;;) {
+        ssize_t count = read(fd.fd,buffer,sizeof(buffer));
+        if (count < 0) { if (errno == EINTR) continue; return -errno; }
+        if (count == 0) break;
+        if (value.size()+size_t(count) > kMaxProcBytes) return -EFBIG;
+        value.append(buffer,size_t(count));
+    }
+    *out = std::move(value); return 0;
+}
+int safeOpen(const char* path, bool character) {
+    Fd fd(open(path,(character?O_RDONLY:O_WRONLY)|O_CLOEXEC|O_NOFOLLOW));
+    if (fd.fd < 0) return -errno;
+    struct stat value;
+    if (fstat(fd.fd,&value)) return -errno;
+    if (character ? !S_ISCHR(value.st_mode) : !S_ISREG(value.st_mode)) return -ENODEV;
+    return 0; // Closing the tracker/control; no control bytes are ever written.
+}
+
+// Only --help and the fixed no-commit --test argv exist in production.
+// Input is prefilled before spawn while its read end is owned, avoiding SIGPIPE
+// and a blocking parent write to an unresponsive child. The fixed input fits one
+// Linux PIPE_BUF (4096) on the explicitly retained kernel.
+int runRestore(const char* binary, bool help, const std::string& input,
+               std::string* output, int timeoutMs) {
+    if (!output || timeoutMs <= 0 || input.size() >= 4096) return -EINVAL;
+    int inPipe[2], outPipe[2];
+    if (pipe2(inPipe,O_CLOEXEC)) return -errno;
+    Fd inRead(inPipe[0]), inWrite(inPipe[1]);
+    if (pipe2(outPipe,O_CLOEXEC)) return -errno;
+    Fd outRead(outPipe[0]), outWrite(outPipe[1]);
+    if (!input.empty()) {
+        ssize_t count;
+        do { count = write(inWrite.fd,input.data(),input.size()); } while (count < 0 && errno == EINTR);
+        if (count < 0) return -errno;
+        if (size_t(count) != input.size()) return -EIO;
+    }
+    inWrite.reset();
+    posix_spawn_file_actions_t actions;
+    int error = posix_spawn_file_actions_init(&actions);
+    if (error) return -error;
+    error = posix_spawn_file_actions_adddup2(&actions,inRead.fd,STDIN_FILENO);
+    if (!error) error = posix_spawn_file_actions_adddup2(&actions,outWrite.fd,STDOUT_FILENO);
+    if (!error) error = posix_spawn_file_actions_adddup2(&actions,outWrite.fd,STDERR_FILENO);
+    for (int fd : {inRead.fd,outRead.fd,outWrite.fd}) {
+        if (!error && fd > STDERR_FILENO) error = posix_spawn_file_actions_addclose(&actions,fd);
+    }
+    char* helpArgs[] = {const_cast<char*>(binary),const_cast<char*>("--help"),nullptr};
+    char* testArgs[] = {const_cast<char*>(binary),const_cast<char*>("--test"),
+        const_cast<char*>("--noflush"),const_cast<char*>("--wait"),const_cast<char*>("2"),nullptr};
+    pid_t child = -1;
+    if (!error) error = posix_spawn(&child,binary,&actions,nullptr,help?helpArgs:testArgs,environ);
+    posix_spawn_file_actions_destroy(&actions);
+    if (error) return -error;
+    inRead.reset(); outWrite.reset();
+    bool reaped = false; int childStatus = 0;
+    const auto finishError = [&](int result) {
+        if (!reaped) {
+            kill(child,SIGKILL); // Only the unreaped owned child PID can be signalled.
+            pid_t waited; do { waited = waitpid(child,&childStatus,0); } while (waited < 0 && errno == EINTR);
+        }
+        return result;
+    };
+    int flags = fcntl(outRead.fd,F_GETFL);
+    if (flags < 0 || fcntl(outRead.fd,F_SETFL,flags|O_NONBLOCK)) return finishError(-errno);
+    const auto deadline = std::chrono::steady_clock::now()+std::chrono::milliseconds(timeoutMs);
+    std::string value; bool eof = false;
+    for (;;) {
+        char buffer[4096];
+        for (;;) {
+            ssize_t count = read(outRead.fd,buffer,sizeof(buffer));
+            if (count < 0) { if (errno == EINTR) continue; if (errno == EAGAIN) break; return finishError(-errno); }
+            if (count == 0) { eof = true; break; }
+            if (value.size()+size_t(count) > kMaxCommandOutput) return finishError(-EFBIG);
+            value.append(buffer,size_t(count));
+        }
+        if (!reaped) {
+            pid_t waited = waitpid(child,&childStatus,WNOHANG);
+            if (waited == child) reaped = true;
+            else if (waited < 0 && errno != EINTR) {
+                const int result = -errno;
+                // Another reaper/SA_NOCLDWAIT may have consumed the child.
+                // Its numeric PID is no longer ours to signal after ECHILD.
+                if (errno == ECHILD) reaped = true;
+                return finishError(result);
+            }
+        }
+        if (reaped && eof) {
+            if (!WIFEXITED(childStatus) || WEXITSTATUS(childStatus)) return -EREMOTEIO;
+            *output = std::move(value); return 0;
+        }
+        if (std::chrono::steady_clock::now() >= deadline) return finishError(-ETIMEDOUT);
+        struct pollfd descriptor {outRead.fd,POLLIN|POLLHUP,0};
+        if (poll(eof?nullptr:&descriptor,eof?0:1,25) < 0 && errno != EINTR) return finishError(-errno);
+    }
+}
+int requested(RequestedNetworkBackend* out,void*) noexcept { return GetRequestedNetworkBackend(out); }
+int readText(RetainedText input,std::string* out,void*) noexcept {
+    switch (input) {
+        case RetainedText::KernelRelease: {
+            struct utsname value; if (uname(&value)) return -errno;
+            *out = value.release; return 0;
+        }
+        case RetainedText::BootSerial: *out = android::base::GetProperty("ro.product.vendor.device",""); return 0;
+        case RetainedText::RestoreHelp4: return runRestore("/system/bin/iptables-restore",true,"",out,kCommandDeadlineMs);
+        case RetainedText::RestoreHelp6: return runRestore("/system/bin/ip6tables-restore",true,"",out,kCommandDeadlineMs);
+        default: break;
+    }
+    const char* path = nullptr;
+    switch (input) {
+        case RetainedText::Stats: path="/proc/net/xt_qtaguid/stats"; break;
+        case RetainedText::IfaceAll: path="/proc/net/xt_qtaguid/iface_stat_all"; break;
+        case RetainedText::IfaceFormatted: path="/proc/net/xt_qtaguid/iface_stat_fmt"; break;
+        case RetainedText::Matches4: path="/proc/net/ip_tables_matches"; break;
+        case RetainedText::Matches6: path="/proc/net/ip6_tables_matches"; break;
+        case RetainedText::Tables4: path="/proc/net/ip_tables_names"; break;
+        case RetainedText::Tables6: path="/proc/net/ip6_tables_names"; break;
+        case RetainedText::Targets4: path="/proc/net/ip_tables_targets"; break;
+        case RetainedText::Targets6: path="/proc/net/ip6_tables_targets"; break;
+        default: return -EINVAL;
+    }
+    return readFile(path,out);
+}
+int openControl(void*) noexcept { return safeOpen("/proc/net/xt_qtaguid/ctrl",false); }
+int openTracker(void*) noexcept { return safeOpen("/dev/xt_qtaguid",true); }
+int restoreTest(bool ipv6,const std::string& input,void*) noexcept {
+    if (input != kRetainedRestoreInput) return -EINVAL;
+    std::string output;
+    return runRestore(ipv6?"/system/bin/ip6tables-restore":"/system/bin/iptables-restore",
+                      false,input,&output,kCommandDeadlineMs);
+}
+}  // namespace
+int VerifyRetainedNetworkPrerequisites(OwnerAttribution* out) noexcept {
+    const RetainedPrerequisiteProbe probe {requested,readText,openControl,openTracker,restoreTest,nullptr};
+    return VerifyRetainedNetworkPrerequisitesWithProbe(probe,out);
+}
+#ifdef TRONA_RETAINED_PREREQUISITES_TEST
+int RunRetainedRestoreForTest(const char* binary,bool help,const std::string& input,
+                             std::string* output,int deadlineMs) {
+    return runRestore(binary,help,input,output,deadlineMs);
+}
+int OpenRetainedPathForTest(const char* path,bool character) { return safeOpen(path,character); }
+#endif
+}  // namespace trona::network
