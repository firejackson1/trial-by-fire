@@ -0,0 +1,15 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+#include <cstdint>
+
+namespace trona::network {
+// Privileged action, not authorization: call only after the dispatcher verifies
+// the captured peer and resolves/authorizes the full charge UID. Caller must
+// retain exclusive ownership of the received FD through completion. No UID
+// sentinel is accepted here. The existing writer retains a process tracker.
+// Never enable until native startup has verified the genuine legacy backend.
+// Returns zero or negative errno; no FD is closed here.
+int TagLegacySocket(int socketFd, uint32_t tag, uint32_t resolvedChargeUid);
+int UntagLegacySocket(int socketFd);
+}  // namespace trona::network
diff --git a/server/trona/tag-auth/LegacyTagDispatcher.cpp b/server/trona/tag-auth/LegacyTagDispatcher.cpp
new file mode 100644
index 0000000..143597e
--- /dev/null
+++ b/server/trona/tag-auth/LegacyTagDispatcher.cpp
@@ -0,0 +1,251 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "LegacyTagDispatcher.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cerrno>
+#include <condition_variable>
+#include <deque>
+#include <fcntl.h>
+#include <cstdlib>
+#include <pthread.h>
+#include <unistd.h>
+#include <vector>
+
+namespace trona::network {
+namespace {
+using Clock = LegacyTagRequest::Clock;
+
+void complete(std::unique_ptr<LegacyTagRequest> request, int error) noexcept {
+    auto completion = std::move(request->completion);
+    request.reset();  // Close received socket before replying/releasing the client.
+    if (completion) completion->complete(error);
+}
+
+bool exempt(uint32_t peerUid, uint32_t chargeUid) {
+    const uint32_t appId = peerUid % 100000;
+    return peerUid == chargeUid || appId == 0 || appId == 1000 || appId == 1051;
+}
+}  // namespace
+
+LegacyTagRequest::LegacyTagRequest(AuthenticatedTagPeer identity, int fd, uint32_t value,
+        uint32_t chargeUid, Clock::time_point expiry,
+        std::unique_ptr<LegacyTagCompletion> reply)
+    : peer(identity), socketFd(fd), tag(value), requestedChargeUid(chargeUid),
+      deadline(expiry), completion(std::move(reply)) {}
+
+LegacyTagRequest::~LegacyTagRequest() {
+    if (socketFd >= 0) close(socketFd);
+}
+
+struct LegacyTagDispatcher::Core {
+    struct Pending {
+        const AuthenticatedTagPeer peer;
+        const uint32_t chargeUid;
+        const Clock::time_point deadline;
+        std::mutex mutex;
+        std::atomic<bool> done{false};
+        std::unique_ptr<LegacyTagRequest> request;
+
+        Pending(std::unique_ptr<LegacyTagRequest> value, uint32_t charge,
+                Clock::time_point expiry)
+            : peer(value->peer), chargeUid(charge), deadline(expiry), request(std::move(value)) {}
+
+        void cancel(int error) noexcept {
+            std::unique_ptr<LegacyTagRequest> owned;
+            {
+                std::lock_guard<std::mutex> lock(mutex);
+                if (!request) return;
+                owned = std::move(request);
+                done.store(true);
+            }
+            complete(std::move(owned), error);
+        }
+
+        void resolve(int authorization, const std::shared_ptr<LegacySocketTagger>& tagger,
+                     const std::atomic<bool>& stopping) noexcept {
+            std::unique_ptr<LegacyTagRequest> owned;
+            int error;
+            bool commitTag = false;
+            {
+                std::lock_guard<std::mutex> lock(mutex);
+                if (!request) return;  // Deadline/shutdown permanently removed its tag target.
+                if (stopping.load()) error = -ECANCELED;
+                else if (Clock::now() >= deadline) error = -ETIMEDOUT;
+                else if (authorization != 0) error = -EPERM;
+                else if (!tagger) error = -ENOSYS;
+                else { error = 0; commitTag = true; }
+                owned = std::move(request);
+                done.store(true);
+            }
+            // Moving ownership out above is the authorization commit boundary.
+            // A later timeout cannot tag or cancel it; an already committed local
+            // syscall has no proven hard latency bound. Do not hold the pending
+            // lock through that syscall or delay other requests' timeout cleanup.
+            if (commitTag) error = tagger->tag(owned->socketFd, owned->tag, chargeUid);
+            complete(std::move(owned), error);
+        }
+    };
+
+    const std::shared_ptr<LegacyTagPermissionQuery> query;
+    const std::shared_ptr<LegacySocketTagger> tagger;
+    std::atomic<bool> stopping{false};
+    std::mutex mutex;
+    std::condition_variable workChanged, deadlinesChanged;
+    std::deque<std::shared_ptr<Pending>> queue;
+    std::vector<std::shared_ptr<Pending>> admitted;
+
+    Core(std::shared_ptr<LegacyTagPermissionQuery> oracle,
+         std::shared_ptr<LegacySocketTagger> action)
+        : query(std::move(oracle)), tagger(std::move(action)) {}
+
+    void worker() noexcept {
+        for (;;) {
+            std::shared_ptr<Pending> pending;
+            {
+                std::unique_lock<std::mutex> lock(mutex);
+                workChanged.wait(lock, [&] { return stopping.load() || !queue.empty(); });
+                if (stopping.load()) return;
+                pending = queue.front(); queue.pop_front();
+            }
+            if (!pending->done.load() && Clock::now() >= pending->deadline) {
+                pending->cancel(-ETIMEDOUT);
+            } else if (!pending->done.load()) {
+                int authorization = -EPERM;
+                if (query) authorization = query->check(pending->peer);
+                pending->resolve(authorization, tagger, stopping);
+            }
+            {
+                std::lock_guard<std::mutex> lock(mutex);
+                admitted.erase(std::remove(admitted.begin(), admitted.end(), pending), admitted.end());
+            }
+            deadlinesChanged.notify_one();
+        }
+    }
+
+    void expire() noexcept {
+        std::unique_lock<std::mutex> lock(mutex);
+        while (!stopping.load()) {
+            auto next = Clock::time_point::max();
+            for (const auto& pending : admitted) {
+                if (!pending->done.load()) next = std::min(next, pending->deadline);
+            }
+            if (next == Clock::time_point::max()) {
+                deadlinesChanged.wait(lock);
+            } else if (Clock::now() < next) {
+                deadlinesChanged.wait_until(lock, next);
+            } else {
+                std::vector<std::shared_ptr<Pending>> expired;
+                for (const auto& pending : admitted) {
+                    if (!pending->done.load() && pending->deadline <= Clock::now()) {
+                        expired.push_back(pending);
+                    }
+                }
+                lock.unlock();
+                for (const auto& pending : expired) pending->cancel(-ETIMEDOUT);
+                lock.lock();
+            }
+        }
+    }
+
+    void stop() noexcept {
+        std::vector<std::shared_ptr<Pending>> pending;
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            stopping.store(true);
+            pending = admitted;
+        }
+        workChanged.notify_all(); deadlinesChanged.notify_all();
+        for (const auto& request : pending) request->cancel(-ECANCELED);
+    }
+
+    struct ThreadStart { std::shared_ptr<Core> core; bool deadline; };
+    static void* runThread(void* argument) noexcept {
+        std::unique_ptr<ThreadStart> start(static_cast<ThreadStart*>(argument));
+        auto core = start->core;
+        const bool deadline = start->deadline;
+        start.reset();
+        if (deadline) core->expire(); else core->worker();
+        return nullptr;
+    }
+};
+
+std::mutex LegacyTagDispatcher::instanceMutex_;
+std::weak_ptr<LegacyTagDispatcher::Core> LegacyTagDispatcher::liveCore_;
+
+std::unique_ptr<LegacyTagDispatcher> LegacyTagDispatcher::create(
+        std::shared_ptr<LegacyTagPermissionQuery> query,
+        std::shared_ptr<LegacySocketTagger> tagger, int* error) noexcept {
+    if (error) *error = 0;
+    std::lock_guard<std::mutex> lock(instanceMutex_);
+    if (!liveCore_.expired()) {
+        if (error) *error = -EBUSY;
+        return nullptr;
+    }
+    auto core = std::make_shared<Core>(std::move(query), std::move(tagger));
+    liveCore_ = core;
+    for (size_t i = 0; i <= kWorkerCount; ++i) {
+        auto start = std::make_unique<Core::ThreadStart>(Core::ThreadStart{core, i == kWorkerCount});
+        pthread_t thread;
+        const int status = pthread_create(&thread, nullptr, Core::runThread, start.get());
+        if (status != 0) {
+            core->stop();
+            if (error) *error = -status;
+            return nullptr;
+        }
+        start.release();
+        // A just-created joinable thread must be detachable. Fail startup if its
+        // lifecycle cannot be accounted for, rather than start another pool.
+        if (pthread_detach(thread) != 0) std::abort();
+    }
+    return std::unique_ptr<LegacyTagDispatcher>(new LegacyTagDispatcher(std::move(core)));
+}
+
+LegacyTagDispatcher::~LegacyTagDispatcher() {
+    core_->stop();
+    // Binder cannot cancel a hung call. Fixed workers retain Core/query lifetime,
+    // and an uncommitted request has no FD/client lease after cancellation.
+    // Already committed local actions retain theirs until they return.
+    // liveCore_ prevents replacement pools until
+    // all old workers exit, keeping even repeated teardown resource-bounded.
+}
+
+LegacyTagDispatcher::Submission LegacyTagDispatcher::submit(
+        std::unique_ptr<LegacyTagRequest> request) {
+    if (!request) return Submission::Completed;
+    if (request->peer.pid <= 0 || request->peer.uid == UINT32_MAX || !request->completion) {
+        complete(std::move(request), -EINVAL); return Submission::Completed;
+    }
+    if (request->socketFd < 0 || fcntl(request->socketFd, F_GETFD) == -1) {
+        complete(std::move(request), -EBADF); return Submission::Completed;
+    }
+    const uint32_t charge = request->requestedChargeUid == UINT32_MAX
+            ? request->peer.uid : request->requestedChargeUid;
+    if (charge == 1029) {
+        complete(std::move(request), -EPERM); return Submission::Completed;
+    }
+    const auto deadline = std::min(request->deadline, Clock::now() + kMaxDelay);
+    if (Clock::now() >= deadline) {
+        complete(std::move(request), -ETIMEDOUT); return Submission::Completed;
+    }
+    if (exempt(request->peer.uid, charge)) {
+        int error = -ENOSYS;
+        if (core_->tagger) error = core_->tagger->tag(request->socketFd, request->tag, charge);
+        complete(std::move(request), error); return Submission::Completed;
+    }
+    auto pending = std::make_shared<Core::Pending>(std::move(request), charge, deadline);
+    bool admitted = false;
+    {
+        std::lock_guard<std::mutex> lock(core_->mutex);
+        if (core_->admitted.size() < kMaxAdmitted) {
+            core_->admitted.push_back(pending);
+            core_->queue.push_back(pending);
+            admitted = true;
+        }
+    }
+    if (!admitted) { pending->cancel(-EAGAIN); return Submission::Completed; }
+    core_->workChanged.notify_one(); core_->deadlinesChanged.notify_one();
+    return Submission::Deferred;
+}
+
+}  // namespace trona::network
diff --git a/server/trona/tag-auth/LegacyTagDispatcher.h b/server/trona/tag-auth/LegacyTagDispatcher.h
new file mode 100644
index 0000000..c5c794e
--- /dev/null
+++ b/server/trona/tag-auth/LegacyTagDispatcher.h
@@ -0,0 +1,87 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <utility>
+
+namespace trona::network {
+
+// The caller captures these from SocketClient's SO_PEERCRED-backed accessors.
+// This value object preserves identity; constructing it does not authenticate it.
+struct AuthenticatedTagPeer { int32_t pid; uint32_t uid; };
+
+class LegacyTagPermissionQuery {
+public:
+    virtual ~LegacyTagPermissionQuery() = default;
+    // Uncached authoritative query. Zero grants; every other result denies.
+    // May block indefinitely. Only the fixed query workers may invoke it.
+    virtual int check(AuthenticatedTagPeer peer) noexcept = 0;
+};
+
+class LegacySocketTagger {
+public:
+    virtual ~LegacySocketTagger() = default;
+    // Local tag operation, without Binder calls or controller locks. Zero or a
+    // negative errno. Its kernel syscall has no promised hard latency bound.
+    virtual int tag(int socketFd, uint32_t tag, uint32_t chargeUid) noexcept = 0;
+};
+
+class LegacyTagCompletion {
+public:
+    virtual ~LegacyTagCompletion() = default;
+    // Must be nonblocking/noexcept; destructor releases the retained client lease.
+    virtual void complete(int error) noexcept = 0;
+};
+
+struct LegacyTagRequest {
+    using Clock = std::chrono::steady_clock;
+    const AuthenticatedTagPeer peer;
+    const int socketFd;
+    const uint32_t tag;
+    const uint32_t requestedChargeUid;
+    const Clock::time_point deadline;
+    std::unique_ptr<LegacyTagCompletion> completion;
+
+    LegacyTagRequest(AuthenticatedTagPeer, int receivedFd, uint32_t tag,
+                     uint32_t requestedChargeUid, Clock::time_point deadline,
+                     std::unique_ptr<LegacyTagCompletion>);
+    ~LegacyTagRequest();
+    LegacyTagRequest(const LegacyTagRequest&) = delete;
+    LegacyTagRequest& operator=(const LegacyTagRequest&) = delete;
+};
+
+class LegacyTagDispatcher {
+public:
+    static constexpr size_t kWorkerCount = 2;
+    static constexpr size_t kMaxAdmitted = 4;
+    static constexpr std::chrono::milliseconds kMaxDelay{250};
+    enum class Submission { Completed, Deferred };
+
+    // No exceptions: creation returns null with negative errno on busy/thread failure.
+    // As with ordinary Android C++ allocations, allocation failure is process-fatal.
+    static std::unique_ptr<LegacyTagDispatcher> create(
+            std::shared_ptr<LegacyTagPermissionQuery>, std::shared_ptr<LegacySocketTagger>,
+            int* error) noexcept;
+    ~LegacyTagDispatcher();
+    LegacyTagDispatcher(const LegacyTagDispatcher&) = delete;
+    LegacyTagDispatcher& operator=(const LegacyTagDispatcher&) = delete;
+
+    // Always consumes FD and completion/client ownership, including rejection.
+    // Deadline bounds pending authorization and its commit, not an already
+    // committed local syscall or its reply latency.
+    Submission submit(std::unique_ptr<LegacyTagRequest>);
+
+private:
+    struct Core;
+    explicit LegacyTagDispatcher(std::shared_ptr<Core> core) : core_(std::move(core)) {}
+    std::shared_ptr<Core> core_;
+    // One process-wide fixed budget. A hung old query prevents replacement pools.
+    static std::mutex instanceMutex_;
+    static std::weak_ptr<Core> liveCore_;
+};
+
+}  // namespace trona::network
diff --git a/server/trona/tag-auth/LegacyTagPermissionOracle.cpp b/server/trona/tag-auth/LegacyTagPermissionOracle.cpp
