@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+#include "LegacyTagDispatcher.h"
+
+class SocketClient;
+
+namespace trona::network {
+
+// Acquire while FwmarkServer's onDataAvailable still owns the client's reference.
+// The selecting caller must suppress its ordinary FD close/reply and return false
+// exactly as before: this lease then owns the single reply and final client ref.
+class SocketClientTagCompletion final : public LegacyTagCompletion {
+public:
+    explicit SocketClientTagCompletion(SocketClient* client);
+    ~SocketClientTagCompletion() override;
+    SocketClientTagCompletion(const SocketClientTagCompletion&) = delete;
+    SocketClientTagCompletion& operator=(const SocketClientTagCompletion&) = delete;
+    void complete(int error) noexcept override;
+
+private:
+    SocketClient* const client_;
+};
+
+}  // namespace trona::network
