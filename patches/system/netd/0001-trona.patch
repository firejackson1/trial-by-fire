@@ -0,0 +1,11 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+#include <cstdint>
+#include <sys/types.h>
+
+namespace trona::network {
+// Return 0 on a complete kernel control write, otherwise a negative errno.
+int tagSocketFromClient(int socketFd, uint32_t tag, uid_t uid);
+int untagSocketFromClient(int socketFd);
+}
