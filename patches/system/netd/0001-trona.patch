+// SPDX-License-Identifier: Apache-2.0
+// Generated from pinned existing evidence; not runtime kernel attestation.
+#pragma once
+namespace trona::network {
+inline constexpr char kRetainedMeasuredKernel[] = "4.4.302-lineage-trona17wifiapi1";
+// Any Fire HD 10 (2021) running its retained vendor partition (ro.product.vendor.device).
+inline constexpr char kRetainedVendorDevice[] = "trona";
+inline constexpr char kRetainedStatsHeader[] = "idx iface acct_tag_hex uid_tag_int cnt_set rx_bytes rx_packets tx_bytes tx_packets rx_tcp_bytes rx_tcp_packets rx_udp_bytes rx_udp_packets rx_other_bytes rx_other_packets tx_tcp_bytes tx_tcp_packets tx_udp_bytes tx_udp_packets tx_other_bytes tx_other_packets";
+inline constexpr char kRetainedIfaceHeader[] = "ifname total_skb_rx_bytes total_skb_rx_packets total_skb_tx_bytes total_skb_tx_packets rx_tcp_bytes rx_tcp_packets rx_udp_bytes rx_udp_packets rx_other_bytes rx_other_packets tx_tcp_bytes tx_tcp_packets tx_udp_bytes tx_udp_packets tx_other_bytes tx_other_packets";
+inline constexpr char kRetainedOwnerEvidenceSha256[] = "e2e0c5cddf97c01c667c28a779de9e874377ad9647fbc61639a027815ffaea2b";
+inline constexpr char kRetainedMutationEvidenceSha256[] = "1c5cc14e4c6f320299cc73456147ae13d4015e2c728d4cdf405e4a499027e35b";
+inline constexpr char kRetainedPrerequisiteEvidenceSha256[] = "ef4040730a7404690492c400886a40f4d24eb7ae6722aa53f9dfe47b3443e6d9";
+inline constexpr char kRetainedRestoreInput[] = R"retained(*filter
+:tr_verify_preflight - [0:0]
+-A tr_verify_preflight -m owner --socket-exists -j RETURN
+-A tr_verify_preflight -m owner --uid-owner 0 -j RETURN
+-A tr_verify_preflight -m quota2 --name tr_verify_quota --quota 1 -j RETURN
+-A tr_verify_preflight -m mark --mark 0x100000/0x100000 -j RETURN
+-A tr_verify_preflight -m comment --comment "trona prerequisites" -j RETURN
+-A tr_verify_preflight -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN
+-A tr_verify_preflight -j REJECT
+COMMIT
+*raw
+:tr_verify_preflight - [0:0]
+-A tr_verify_preflight -m policy --pol ipsec --dir in -j RETURN
+COMMIT
+*mangle
+:tr_verify_preflight - [0:0]
+-A tr_verify_preflight -m policy --pol ipsec --dir out -j RETURN
