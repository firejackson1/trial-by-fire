+// Android second-stage hooks may activate this diagnostic worker.
+#if defined(TRONA_EARLY_RECORDER) && defined(__ANDROID__) && !defined(MICRODROID) && \
+        !defined(RECOVERY) && !defined(FIRST_STAGE_INIT)
