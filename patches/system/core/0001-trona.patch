+// BEGIN retained netd lifecycle fence
+// This only fences the existing explicit legacy netd lifecycle. Native profile
+// validation and readiness publication remain in netd, not in init.
+static uint64_t trona_netd_generation_counter = 0;
+static bool IsTronaLegacyNetd(const std::string& service_name) {
+    return service_name == "netd" && GetProperty("ro.trona.network_backend", "") == "legacy";
+}
+static bool SetTronaNetdLifecycleProperty(const std::string& name, const std::string& value) {
+#if INIT_FULL_SOURCES
+    if (InitPropertySet(name, value) == PROP_SUCCESS) return true;
+#else
+    // Host libinit has no property service; retain its existing property boundary.
+    if (SetProperty(name, value)) return true;
+#endif
+    LOG(ERROR) << "Cannot update selected legacy netd lifecycle property " << name;
+    return false;
+}
+static bool ResetTronaNetdReadiness(const std::string& service_name) {
+    if (!IsTronaLegacyNetd(service_name)) return true;
+    // Invalidate the init-owned generation FIRST: any delayed old ready write
+    // remains unusable even if its property request commits after this reset.
+    return SetTronaNetdLifecycleProperty("sys.trona.netd_generation", "0") &&
+           SetTronaNetdLifecycleProperty("sys.trona.netd_ready", "0");
+}
+static bool PrepareTronaNetdGeneration(const std::string& service_name) {
+    if (!IsTronaLegacyNetd(service_name)) return true;
+    if (!ResetTronaNetdReadiness(service_name)) return false;
+    // Service lifecycle runs on init's main thread. Consume every attempt's
+    // nonce, including failed forks; never reuse an earlier daemon's generation.
+    if (trona_netd_generation_counter == UINT64_MAX) return false;
+    return SetTronaNetdLifecycleProperty("sys.trona.netd_generation",
+                                        std::to_string(++trona_netd_generation_counter));
+}
+// END retained netd lifecycle fence
