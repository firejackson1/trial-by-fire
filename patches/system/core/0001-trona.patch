+#pragma once
+#include <array>
+#include <cstdint>
+#include <string>
+#include <sys/types.h>
+namespace trona_recorder {
+constexpr size_t kRecordBytes = 128, kMaxRecords = 256,
+                 kMaxJournalBytes = 65536;
+using Record = std::array<unsigned char, kRecordBytes>;
+bool ValidBootId(const std::string &id);
+Record MakeRecord(uint32_t seq, uint32_t lost, uint16_t event, uint64_t ns,
+                  uint32_t detail, int32_t status, uint32_t source = 0,
+                  uint32_t line = 0);
+bool ValidRecord(const Record &record);
+uint32_t RecordSequence(const Record &record);
+int SendRecord(int fd, const Record &record);
+bool MatchMount(const std::string &text, const std::string &target,
+                unsigned major, unsigned minor);
+struct JournalResult {
+  int error = 0;
+  size_t records = 0;
+  bool sync_ack = false;
+};
+using WriteFn = ssize_t (*)(int, const void *, size_t);
+using SyncFn = int (*)(int);
+int OpenJournal(int parent, const std::string &boot, const std::string &build,
+                uid_t uid = 0, gid_t gid = 0);
+int AppendBatch(int fd, const Record *records, size_t count,
+                WriteFn writer = nullptr, SyncFn syncer = nullptr);
+JournalResult InspectJournal(int fd, const std::string &boot);
+} // namespace trona_recorder
