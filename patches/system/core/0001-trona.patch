+uint32_t Get32(const unsigned char *p) {
+  return uint32_t(p[0]) | (uint32_t(p[1]) << 8) | (uint32_t(p[2]) << 16) |
+         (uint32_t(p[3]) << 24);
+}
+void Put32(unsigned char *p, uint32_t v) {
+  for (int i = 0; i < 4; ++i)
+    p[i] = static_cast<unsigned char>(v >> (8 * i));
+}
+void Put64(unsigned char *p, uint64_t v) {
+  for (int i = 0; i < 8; ++i)
+    p[i] = static_cast<unsigned char>(v >> (8 * i));
+}
+uint32_t Crc(const void *v, size_t n) {
+  auto p = static_cast<const unsigned char *>(v);
+  uint32_t c = ~0u;
+  for (size_t i = 0; i < n; ++i) {
+    c ^= p[i];
+    for (int b = 0; b < 8; ++b)
+      c = (c >> 1) ^ ((c & 1) ? 0xedb88320u : 0);
+  }
+  return ~c;
+}
+int WriteBounded(int fd, const void *p, size_t n, WriteFn writer) {
+  auto b = static_cast<const unsigned char *>(p);
+  for (int i = 0; i < 8 && n; ++i) {
+    ssize_t k = writer(fd, b, n);
+    if (k < 0)
+      return -errno;
+    if (k == 0 || size_t(k) > n)
+      return -EIO;
+    b += k;
+    n -= k;
+  }
+  return n ? -EIO : 0;
+}
+bool Option(const std::string &value, const std::string &token) {
+  std::istringstream in(value);
+  std::string s;
+  while (std::getline(in, s, ','))
+    if (s == token)
+      return true;
+  return false;
+}
+bool Number(const std::string &s, unsigned *n) {
+  auto r = std::from_chars(s.data(), s.data() + s.size(), *n);
+  return !s.empty() && r.ec == std::errc{} && r.ptr == s.data() + s.size();
+}
+int CheckFile(int fd) {
+  struct stat st{};
+  if (fstat(fd, &st))
+    return -errno;
+  if (!S_ISREG(st.st_mode) || st.st_uid != getuid() || st.st_gid != getgid() ||
+      st.st_nlink != 1 || (st.st_mode & 07777) != 0600 || st.st_size < 128)
+    return -EPERM;
+  if (st.st_size > off_t(kMaxJournalBytes))
+    return -EFBIG;
+  return 0;
+}
+} // namespace
+bool ValidBootId(const std::string &id) {
+  if (id.size() != 36)
+    return false;
+  bool nonzero = false;
+  for (size_t i = 0; i < id.size(); ++i) {
+    if (i == 8 || i == 13 || i == 18 || i == 23) {
+      if (id[i] != '-')
+        return false;
+    } else {
+      char c = id[i];
+      if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')))
+        return false;
+      nonzero |= c != '0';
+    }
+  }
+  return nonzero;
+}
+Record MakeRecord(uint32_t seq, uint32_t lost, uint16_t event, uint64_t ns,
+                  uint32_t detail, int32_t status, uint32_t source,
+                  uint32_t line) {
+  Record r{};
+  if (!seq || !event)
+    return r;
+  memcpy(r.data(), "TRR1", 4);
+  Put32(r.data() + 4, seq);
+  Put32(r.data() + 8, lost);
+  Put32(r.data() + 12, event);
+  Put64(r.data() + 16, ns);
+  Put32(r.data() + 24, detail);
+  Put32(r.data() + 28, static_cast<uint32_t>(status));
+  Put32(r.data() + 32, source);
+  Put32(r.data() + 36, line);
+  Put32(r.data() + 124, Crc(r.data(), 124));
+  return r;
+}
+bool ValidRecord(const Record &r) {
+  return !memcmp(r.data(), "TRR1", 4) && Get32(r.data() + 4) != 0 &&
+         Get32(r.data() + 12) > 0 && Get32(r.data() + 12) <= 65535 &&
+         Get32(r.data() + 124) == Crc(r.data(), 124);
+}
+uint32_t RecordSequence(const Record &r) { return Get32(r.data() + 4); }
+int SendRecord(int fd, const Record &r) {
+  int saved = errno;
+  int result;
+  if (!ValidRecord(r))
+    result = -EINVAL;
+  else {
+    ssize_t n = send(fd, r.data(), r.size(), MSG_DONTWAIT | MSG_NOSIGNAL);
+    result = n < 0 ? -errno : n == ssize_t(r.size()) ? 0 : -EIO;
+  }
+  errno = saved;
+  return result;
+}
+bool MatchMount(const std::string &text, const std::string &target,
+                unsigned maj, unsigned min) {
+  if (text.empty() || text.size() > 65536 || text.back() != '\n' ||
+      target != "/cache")
+    return false;
+  std::istringstream lines(text);
+  std::string line;
+  unsigned matches = 0;
+  bool valid = false;
+  while (std::getline(lines, line)) {
+    if (line.size() > 2048)
+      return false;
+    std::istringstream input(line);
+    std::vector<std::string> t;
+    for (std::string word; input >> word;) {
+      if (t.size() >= 64)
+        return false;
+      t.push_back(word);
+    }
+    if (t.size() < 10)
+      return false;
+    if (t[4] != target)
+      continue;
+    ++matches;
+    size_t sep = 6;
+    while (sep < t.size() && t[sep] != "-")
+      ++sep;
+    if (sep + 3 >= t.size())
+      return false;
+    auto colon = t[2].find(':');
+    unsigned a = 0, b = 0;
+    if (colon == std::string::npos || !Number(t[2].substr(0, colon), &a) ||
+        !Number(t[2].substr(colon + 1), &b))
+      return false;
+    valid = t[3] == "/" && t[sep + 1] == "ext4" && Option(t[5], "rw") &&
+            !Option(t[5], "ro") && Option(t[sep + 3], "rw") &&
+            !Option(t[sep + 3], "ro") && a == maj && b == min;
+  }
+  return matches == 1 && valid;
+}
+int OpenJournal(int parent, const std::string &boot, const std::string &build,
+                uid_t uid, gid_t gid) {
+  if (!ValidBootId(boot) || build.empty() || build.size() > 63 ||
+      build.find('\0') != std::string::npos)
+    return -EINVAL;
+  struct stat ds{};
+  if (fstat(parent, &ds))
+    return -errno;
+  if (!S_ISDIR(ds.st_mode) || (ds.st_mode & 07777) != 0700 ||
+      ds.st_uid != uid || ds.st_gid != gid)
+    return -EPERM;
+  // A dup shares directory offsets: each validation needs a fresh open
+  // description.
+  int duplicate =
+      openat(parent, ".", O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+  if (duplicate < 0)
+    return -errno;
+  DIR *dir = fdopendir(duplicate);
+  if (!dir) {
+    int e = errno;
+    close(duplicate);
+    return -e;
+  }
+  size_t files = 0, bytes = 0;
+  int error = 0;
+  errno = 0;
+  while (auto entry = readdir(dir)) {
+    std::string name = entry->d_name;
+    if (name == "." || name == "..")
+      continue;
+    if (++files > 16) {
+      error = -ENOSPC;
+      break;
+    }
+    struct stat st{};
+    if (fstatat(parent, name.c_str(), &st, AT_SYMLINK_NOFOLLOW)) {
+      error = -errno;
+      break;
+    }
+    if (!S_ISREG(st.st_mode) || st.st_nlink != 1 || st.st_uid != uid ||
+        st.st_gid != gid || (st.st_mode & 07777) != 0600 ||
+        st.st_dev != ds.st_dev || st.st_size < 0) {
+      error = -EPERM;
+      break;
+    }
+    if (st.st_size > off_t(kMaxJournalBytes)) {
+      error = -EFBIG;
+      break;
+    }
+    bytes += size_t(st.st_size);
+    if (bytes > 1024 * 1024) {
+      error = -ENOSPC;
+      break;
+    }
+    errno = 0;
+  }
+  if (!error && errno)
+    error = -errno;
+  closedir(dir);
+  if (error)
+    return error;
+  if (files >= 16 || bytes + kMaxJournalBytes > 1024 * 1024)
+    return -ENOSPC;
+  int fd = openat(parent, (boot + ".journal").c_str(),
+                  O_RDWR | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600);
+  if (fd < 0)
+    return -errno;
+  struct stat st{};
+  if (fstat(fd, &st) || !S_ISREG(st.st_mode) || st.st_nlink != 1 ||
+      st.st_uid != uid || st.st_gid != gid || (st.st_mode & 07777) != 0600 ||
+      st.st_dev != ds.st_dev) {
+    close(fd);
+    return -EPERM;
+  }
+  std::array<unsigned char, 128> h{};
+  memcpy(h.data(), "TRONAJ1", 7);
+  Put32(h.data() + 8, 1);
+  Put32(h.data() + 12, kRecordBytes);
+  memcpy(h.data() + 16, boot.data(), 36);
+  memcpy(h.data() + 53, build.data(), build.size());
+  Put32(h.data() + 124, Crc(h.data(), 124));
+  error = WriteBounded(fd, h.data(), h.size(), write);
+  if (!error && fsync(fd))
+    error = -errno;
+  if (!error && fsync(parent))
+    error = -errno;
+  if (error) {
+    close(fd);
+    return error;
+  }
+  return fd;
+}
+int AppendBatch(int fd, const Record *records, size_t count, WriteFn writer,
+                SyncFn syncer) {
+  if (!records || !count)
+    return -EINVAL;
+  if (count > kMaxRecords)
+    return -E2BIG;
+  if (!writer)
+    writer = write;
+  if (!syncer)
+    syncer = fsync;
+  int e = CheckFile(fd);
+  if (e)
+    return e;
+  for (size_t i = 0; i < count; ++i)
+    if (!ValidRecord(records[i]) ||
+        (i && RecordSequence(records[i]) <= RecordSequence(records[i - 1])))
+      return -EINVAL;
+  std::array<unsigned char, 128> existing{};
+  if (pread(fd, existing.data(), existing.size(), 0) != 128)
+    return -EIO;
+  auto prefix = InspectJournal(
+      fd,
+      std::string(reinterpret_cast<const char *>(existing.data() + 16), 36));
+  if (prefix.error)
+    return prefix.error;
+  if (prefix.records + count > kMaxRecords)
+    return -E2BIG;
+  struct stat st{};
+  if (fstat(fd, &st))
+    return -errno;
+  size_t payload = count * kRecordBytes;
+  if (size_t(st.st_size) + payload + 96 > kMaxJournalBytes)
+    return -EFBIG;
+  std::array<unsigned char, 32> frame{};
+  memcpy(frame.data(), "BATCH1", 6);
+  Put32(frame.data() + 8, count);
+  Put32(frame.data() + 12, payload);
+  Put32(frame.data() + 16, Crc(records, payload));
+  Put32(frame.data() + 28, Crc(frame.data(), 28));
+  std::array<unsigned char, 32> end{};
+  memcpy(end.data(), "END1", 4);
+  Put32(end.data() + 8, RecordSequence(records[count - 1]));
+  Put32(end.data() + 12, Get32(frame.data() + 16));
+  Put32(end.data() + 28, Crc(end.data(), 28));
+  if (lseek(fd, 0, SEEK_END) < 0)
+    return -errno;
+  if ((e = WriteBounded(fd, frame.data(), frame.size(), writer)))
+    return e;
+  if ((e = WriteBounded(fd, records, payload, writer)))
+    return e;
+  if ((e = WriteBounded(fd, end.data(), end.size(), writer)))
+    return e;
+  if (syncer(fd))
+    return -errno;
+  memcpy(end.data(), "SYNC1", 5);
+  Put32(end.data() + 28, Crc(end.data(), 28));
+  if ((e = WriteBounded(fd, end.data(), end.size(), writer)))
+    return e;
+  if (syncer(fd))
+    return -errno;
+  return 0;
+}
+JournalResult InspectJournal(int fd, const std::string &boot) {
+  JournalResult out{};
+  if (!ValidBootId(boot))
+    return {-EINVAL, 0, false};
+  int e = CheckFile(fd);
+  if (e)
+    return {e, 0, false};
+  struct stat st{};
+  if (fstat(fd, &st))
+    return {-errno, 0, false};
+  std::vector<unsigned char> bytes(size_t(st.st_size));
+  size_t done = 0;
+  for (int i = 0; i < 32 && done < bytes.size(); ++i) {
+    ssize_t n = pread(fd, bytes.data() + done, bytes.size() - done, done);
+    if (n <= 0)
+      return {n < 0 ? -errno : -EIO, 0, false};
+    done += n;
+  }
+  if (done != bytes.size())
+    return {-EIO, 0, false};
+  auto p = bytes.data();
+  if (memcmp(p, "TRONAJ1", 7) || Get32(p + 8) != 1 || Get32(p + 12) != 128 ||
+      memcmp(p + 16, boot.data(), 36) || p[52] != 0 ||
+      Get32(p + 124) != Crc(p, 124))
+    return {-EBADMSG, 0, false};
+  size_t off = 128;
+  uint32_t previous = 0;
+  while (off < bytes.size()) {
+    if (bytes.size() - off < 32) {
+      out.error = -EBADMSG;
+      break;
+    }
+    p = bytes.data() + off;
+    uint32_t count = Get32(p + 8), len = Get32(p + 12), crc = Get32(p + 16);
+    if (memcmp(p, "BATCH1", 6) || count == 0 || count > kMaxRecords ||
+        len != count * 128 || Get32(p + 28) != Crc(p, 28) ||
+        bytes.size() - off < 32 + len + 32) {
+      out.error = -EBADMSG;
+      break;
+    }
+    auto data = p + 32;
+    if (Crc(data, len) != crc) {
+      out.error = -EBADMSG;
+      break;
+    }
+    bool valid = true;
+    uint32_t last = previous;
+    for (uint32_t i = 0; i < count; ++i) {
+      Record r{};
+      memcpy(r.data(), data + i * 128, 128);
+      if (!ValidRecord(r) || RecordSequence(r) <= last) {
+        valid = false;
+        break;
+      }
+      last = RecordSequence(r);
+    }
+    auto end = data + len;
+    if (!valid || memcmp(end, "END1", 4) || Get32(end + 8) != last ||
+        Get32(end + 12) != crc || Get32(end + 28) != Crc(end, 28)) {
+      out.error = -EBADMSG;
+      break;
+    }
+    out.sync_ack = false;
+    out.records += count;
+    previous = last;
+    off += 32 + len + 32;
+    if (bytes.size() - off < 32) {
+      out.error = -ENODATA;
+      break;
+    }
+    auto ack = bytes.data() + off;
+    if (memcmp(ack, "SYNC1", 5) || Get32(ack + 8) != last ||
+        Get32(ack + 12) != crc || Get32(ack + 28) != Crc(ack, 28)) {
+      out.error = -EBADMSG;
+      break;
+    }
+    out.sync_ack = true;
+    off += 32;
+  }
+  return out;
+}
+} // namespace trona_recorder
