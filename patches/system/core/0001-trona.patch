diff --git a/init/trona_boot_recorder/service_events.h b/init/trona_boot_recorder/service_events.h
new file mode 100755
index 0000000..49eaf58
--- /dev/null
+++ b/init/trona_boot_recorder/service_events.h
@@ -0,0 +1,120 @@
+// SPDX-License-Identifier: Apache-2.0
+// Service lifecycle events for the Trona early-boot recorder (draft v3).
+// Pure helpers only: no I/O, no errno changes, no allocation. Used by
+// service.cpp when TRONA_EARLY_RECORDER_ENABLED; host-testable on its own.
+#pragma once
+#include <array>
+#include <cstdint>
+#include <string_view>
+
+namespace trona_recorder {
+
+// Additive event codes. Decoder v2 reports these as UNKNOWN_EVENT.
+constexpr uint16_t kServiceStartEnter = 360;   // priority services only, before Start() body
+constexpr uint16_t kServiceStartResult = 361;  // every Service::Start() return
+constexpr uint16_t kServiceReap = 460;         // reap not already covered by 450/401-404
+constexpr uint16_t kServiceCrashCount = 461;   // crash_count_ assignment inside Reap()
+constexpr uint16_t kServiceEventsSuppressed = 462;  // per-service budget reached
+constexpr uint16_t kServiceBudgetTableFull = 463;   // too many distinct services
+
+// kServiceStartResult detail bits. Status carries the error code (see StartStatus).
+constexpr uint32_t kStartForked = 1u << 0;         // start_order_ advanced: fork/clone succeeded in this call
+constexpr uint32_t kStartRunningBefore = 1u << 1;  // SVC_RUNNING before the call
+constexpr uint32_t kStartRunningAfter = 1u << 2;   // SVC_RUNNING after the call
+constexpr uint32_t kStartDisabledAfter = 1u << 3;  // SVC_DISABLED after the call
+constexpr uint32_t kStartFailed = 1u << 4;         // Start() returned an error Result
+constexpr uint32_t kStartErrorHasCode = 1u << 5;   // status is the Result error code (errno for ErrnoError)
+
+constexpr uint32_t StartDetail(bool forked, bool running_before, bool running_after,
+                               bool disabled_after, bool failed, int code) {
+    return (forked ? kStartForked : 0) | (running_before ? kStartRunningBefore : 0) |
+           (running_after ? kStartRunningAfter : 0) | (disabled_after ? kStartDisabledAfter : 0) |
+           (failed ? kStartFailed : 0) | (failed && code > 0 ? kStartErrorHasCode : 0);
+}
+
+// 0 = success. Failure: the Result error code when positive (an errno value for
+// ErrnoError), otherwise -1 meaning "Error() without a code". Never the
+// thread's errno, which Start() does not define on return.
+constexpr int32_t StartStatus(bool failed, int code) {
+    return !failed ? 0 : (code > 0 ? code : -1);
+}
+
+// kServiceCrashCount status bits.
+constexpr int32_t kCrashCritical = 1 << 0;    // SVC_CRITICAL
+constexpr int32_t kCrashWindowReset = 1 << 1;  // the "else" branch: count reset to 1
+
+// Services that also get a kServiceStartEnter record. Keep short: every entry
+// costs a record per start attempt from a fixed 256-record budget.
+constexpr std::array<std::string_view, 8> kPriorityServices = {
+        "keystore2",        "vendor.keymaster-3-0", "kisd",
+        "vold",             "servicemanager",       "hwservicemanager",
+        "vndservicemanager", "vendor.gatekeeper-1-0"};
+
+constexpr bool IsPriorityService(std::string_view name) {
+    for (auto candidate : kPriorityServices)
+        if (candidate == name) return true;
+    return false;
+}
+
+// Per-service record budget. A crash-looping service would otherwise consume
+// the whole boot budget and hide later events. The limit is per call, so
+// priority services can be given more room than the rest.
+enum class Admission { kRecord, kSuppressNow, kDrop, kTableFullNow };
+
+template <size_t Slots>
+class ServiceEventBudget {
+  public:
+    // Caller records the event on kRecord, a single kServiceEventsSuppressed
+    // marker on kSuppressNow, a single kServiceBudgetTableFull marker on
+    // kTableFullNow, and nothing on kDrop.
+    Admission Admit(uint32_t id, uint16_t limit) {
+        // Slots fill in order, so the first free slot means `id` is new.
+        for (auto& slot : slots_) {
+            if (slot.in_use && slot.id == id) return Step(slot, limit);
+            if (!slot.in_use) {
+                slot.id = id;
+                slot.in_use = true;
+                return Step(slot, limit);
+            }
+        }
+        if (table_full_marked_) return Admission::kDrop;
+        table_full_marked_ = true;
+        return Admission::kTableFullNow;
+    }
+
+  private:
+    struct Slot {
+        uint32_t id = 0;
+        uint16_t used = 0;
+        bool in_use = false;
+    };
+    static Admission Step(Slot& slot, uint16_t limit) {
+        if (slot.used < limit) {
+            ++slot.used;
+            return Admission::kRecord;
+        }
+        if (slot.used == limit) {
+            ++slot.used;
+            return Admission::kSuppressNow;
+        }
+        return Admission::kDrop;
+    }
+    std::array<Slot, Slots> slots_{};
+    bool table_full_marked_ = false;
+};
+
+constexpr size_t kBudgetSlots = 128;
+constexpr uint16_t kPerServiceLimit = 12;
+// Priority services: 24 covers five full enter/result/reap cycles (15 records),
+// i.e. a critical service's whole path to the fatal fifth crash, with room left.
+constexpr uint16_t kPriorityServiceLimit = 24;
+constexpr uint16_t ServiceLimit(bool priority) {
+    return priority ? kPriorityServiceLimit : kPerServiceLimit;
+}
+// Crash counts 1..5 (5 is init's fatal threshold for critical services) bypass the
+// per-service budget; only the global record cap applies. Higher counts occur only
+// for non-critical updatable services that keep looping and stay budgeted.
+constexpr uint32_t kCrashCountAlwaysRecorded = 5;
+using DefaultServiceEventBudget = ServiceEventBudget<kBudgetSlots>;
+
+}  // namespace trona_recorder
