@@ -0,0 +1,735 @@
+#include "recorder_worker.h"
+#include <array>
+#include <cerrno>
+#include <climits>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <dirent.h>
+#include <string>
+#include <fcntl.h>
+#include <poll.h>
+#include <signal.h>
+#include <sys/prctl.h>
+#include <sys/resource.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/statfs.h>
+#include <sys/statvfs.h>
+#include <sys/syscall.h>
+#include <sys/sysmacros.h>
+#include <time.h>
+#include <unistd.h>
+namespace trona_recorder {
+namespace {
+constexpr char kBuild[] = "early-boot-recorder-private-v2";
+constexpr char kDirectory[] = "trona-boot-recorder";
+constexpr char kCache[] = "/cache";
+constexpr char kBlock[] = "/dev/block/platform/bootdevice/by-name/cache";
+constexpr unsigned kDurationMs = 360000, kProbeMs = 1000, kMaxCheckpoints = 32;
+struct Producer {
+  int fd = -1;
+  uint32_t seq = 0, lost = 0;
+  bool attempted = false;
+} producer;
+uint64_t NowNs() {
+  struct timespec t{};
+  if (clock_gettime(CLOCK_MONOTONIC, &t))
+    return 0;
+  return uint64_t(t.tv_sec) * 1000000000ull + t.tv_nsec;
+}
+int ReadSmall(const char *path, std::string *out, size_t limit) {
+  int f = open(path, O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+  if (f < 0)
+    return -errno;
+  std::string value;
+  std::array<char, 4096> b{};
+  for (unsigned tries = 0; tries < 32; ++tries) {
+    ssize_t n = read(f, b.data(), b.size());
+    if (n < 0) {
+      int e = errno;
+      close(f);
+      return -e;
+    }
+    if (n == 0) {
+      close(f);
+      *out = value;
+      return 0;
+    }
+    if (value.size() + size_t(n) > limit) {
+      close(f);
+      return -EFBIG;
+    }
+    value.append(b.data(), n);
+  }
+  close(f);
+  return -E2BIG;
+}
+int DiscoverCacheDir(const char *name) {
+  std::string mounts;
+  int e = ReadSmall("/proc/self/mountinfo", &mounts, 65536);
+  if (e)
+    return e;
+  struct stat block{};
+  if (stat(kBlock, &block))
+    return -errno;
+  if (!S_ISBLK(block.st_mode))
+    return -ENODEV;
+  if (!MatchMount(mounts, kCache, major(block.st_rdev), minor(block.st_rdev)))
+    return -ENODEV;
+  int cache = open(kCache, O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+  if (cache < 0)
+    return -errno;
+  struct stat cs{};
+  struct statfs fs{};
+  if (fstat(cache, &cs) || fstatfs(cache, &fs)) {
+    e = -errno;
+    close(cache);
+    return e;
+  }
+  if (cs.st_dev != block.st_rdev || fs.f_type != 0xef53 ||
+      (fs.f_flags & ST_RDONLY)) {
+    close(cache);
+    return -ENODEV;
+  }
+  if (mkdirat(cache, name, 0700) && errno != EEXIST) {
+    e = -errno;
+    close(cache);
+    return e;
+  }
+  int dir = openat(cache, name,
+                   O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+  if (dir < 0) {
+    e = -errno;
+    close(cache);
+    return e;
+  }
+  struct stat ds{}, link{};
+  bool ok = fstat(dir, &ds) == 0 &&
+            fstatat(cache, name, &link, AT_SYMLINK_NOFOLLOW) == 0 &&
+            S_ISDIR(ds.st_mode) && S_ISDIR(link.st_mode) &&
+            ds.st_dev == cs.st_dev && ds.st_ino == link.st_ino &&
+            ds.st_dev == link.st_dev && ds.st_uid == 0 && ds.st_gid == 0 &&
+            (ds.st_mode & 07777) == 0700;
+  close(cache);
+  if (!ok) {
+    close(dir);
+    return -EPERM;
+  }
+  return dir;
+}
+int DiscoverCache(void *) { return DiscoverCacheDir(kDirectory); }
+bool ValidateCache(int fd, void *ctx) {
+  int fresh = DiscoverCache(ctx);
+  if (fresh < 0)
+    return false;
+  struct stat a{}, b{};
+  bool ok = fstat(fd, &a) == 0 && fstat(fresh, &b) == 0 &&
+            a.st_dev == b.st_dev && a.st_ino == b.st_ino;
+  close(fresh);
+  return ok;
+}
+using Discover = int (*)(void *);
+using Validate = bool (*)(int, void *);
+constexpr size_t kPmsgFrameBytes = 256, kMaxPmsgFrames = 96;
+static_assert(kPmsgFrameBytes * kMaxPmsgFrames < 0x10000);
+using PmsgFrame = std::array<unsigned char, kPmsgFrameBytes>;
+uint32_t PmsgCrc(const unsigned char *p, size_t n) {
+  uint32_t c = ~0u;
+  for (size_t i = 0; i < n; ++i) {
+    c ^= p[i];
+    for (unsigned j = 0; j < 8; ++j)
+      c = (c >> 1) ^ ((c & 1) ? 0xedb88320u : 0);
+  }
+  return ~c;
+}
+void PmsgPut32(unsigned char *p, uint32_t n) {
+  for (unsigned i = 0; i < 4; ++i)
+    p[i] = n >> (i * 8);
+}
+uint32_t PmsgGet32(const unsigned char *p) {
+  return uint32_t(p[0]) | uint32_t(p[1]) << 8 | uint32_t(p[2]) << 16 |
+         uint32_t(p[3]) << 24;
+}
+PmsgFrame MakePmsgFrame(const std::string &boot, const Record &record,
+                        uint32_t ordinal) {
+  PmsgFrame f{};
+  if (!ValidBootId(boot) || !ValidRecord(record) || ordinal == 0 ||
+      ordinal > kMaxPmsgFrames)
+    return f;
+  memcpy(f.data(), "TRPMSG2", 7);
+  PmsgPut32(f.data() + 8, 2);
+  PmsgPut32(f.data() + 12, kPmsgFrameBytes);
+  memcpy(f.data() + 16, boot.data(), 36);
+  // Informational format tag, not build/cohort authentication.
+  static_assert(sizeof(kBuild) <= 32);
+  memcpy(f.data() + 52, kBuild, sizeof(kBuild));
+  PmsgPut32(f.data() + 84, ordinal);
+  memcpy(f.data() + 96, record.data(), record.size());
+  PmsgPut32(f.data() + 252, PmsgCrc(f.data(), 252));
+  return f;
+}
+bool ValidPmsgFrame(const void *data, size_t n) {
+  if (n != kPmsgFrameBytes)
+    return false;
+  auto p = static_cast<const unsigned char *>(data);
+  if (memcmp(p, "TRPMSG2\0", 8) || PmsgGet32(p + 8) != 2 ||
+      PmsgGet32(p + 12) != kPmsgFrameBytes ||
+      !ValidBootId(std::string(reinterpret_cast<const char *>(p + 16), 36)) ||
+      PmsgGet32(p + 84) == 0 || PmsgGet32(p + 84) > kMaxPmsgFrames ||
+      PmsgGet32(p + 252) != PmsgCrc(p, 252))
+    return false;
+  Record r{};
+  memcpy(r.data(), p + 96, r.size());
+  return ValidRecord(r);
+}
+bool PmsgNodeMatches(const struct stat &before, const struct stat &after) {
+  auto safe = [](const struct stat &s) {
+    return S_ISCHR(s.st_mode) && (s.st_mode & 07777) == 0222 && s.st_uid == 0 &&
+           s.st_gid == 1007 && s.st_nlink == 1;
+  };
+  return safe(before) && safe(after) && before.st_dev == after.st_dev &&
+         before.st_ino == after.st_ino && before.st_rdev == after.st_rdev;
+}
+bool PmsgLinkMatches(const std::string &link) {
+  return link == "../../devices/virtual/pmsg/pmsg0";
+}
+struct PmsgFd {
+  int fd;
+  explicit PmsgFd(int f) : fd(f) {}
+  ~PmsgFd() {
+    if (fd >= 0)
+      close(fd);
+  }
+  PmsgFd(const PmsgFd &) = delete;
+  PmsgFd &operator=(const PmsgFd &) = delete;
+};
+bool SameInode(const struct stat &a, const struct stat &b) {
+  return a.st_dev == b.st_dev && a.st_ino == b.st_ino;
+}
+int OpenPmsgAt(const char *node, const char *sysroot) {
+  struct stat before{}, after{}, final_node{};
+  if (lstat(node, &before))
+    return -errno;
+  if (!PmsgNodeMatches(before, before))
+    return -EPERM;
+  PmsgFd root(open(sysroot, O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW));
+  if (root.fd < 0)
+    return -errno;
+  struct statfs fs{};
+  struct stat root_stat{};
+  if (fstatfs(root.fd, &fs) || fstat(root.fd, &root_stat))
+    return -errno;
+  if (fs.f_type != 0x62656572 || root_stat.st_uid != 0)
+    return -ENODEV;
+  PmsgFd chars(openat(root.fd, "dev/char",
+                      O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW));
+  PmsgFd target(openat(root.fd, "devices/virtual/pmsg/pmsg0",
+                       O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW));
+  if (chars.fd < 0 || target.fd < 0)
+    return -ENOENT; // No unsafe fallback.
+  struct stat chars_stat{}, target_stat{}, link_before{}, linked{},
+      link_after{};
+  if (fstat(chars.fd, &chars_stat) || fstat(target.fd, &target_stat))
+    return -errno;
+  if (chars_stat.st_dev != root_stat.st_dev ||
+      target_stat.st_dev != root_stat.st_dev)
+    return -ENODEV;
+  char name[64]{};
+  int n = snprintf(name, sizeof(name), "%u:%u", major(before.st_rdev),
+                   minor(before.st_rdev));
+  if (n <= 0 || size_t(n) >= sizeof(name))
+    return -EINVAL;
+  if (fstatat(chars.fd, name, &link_before, AT_SYMLINK_NOFOLLOW))
+    return -errno;
+  if (!S_ISLNK(link_before.st_mode) || link_before.st_dev != root_stat.st_dev ||
+      link_before.st_uid != 0)
+    return -ENODEV;
+  char link[128]{};
+  ssize_t length = readlinkat(chars.fd, name, link, sizeof(link));
+  if (length < 0)
+    return -errno;
+  if (size_t(length) >= sizeof(link) ||
+      !PmsgLinkMatches(std::string(link, length)))
+    return -ENODEV;
+  if (fstatat(chars.fd, name, &linked, 0) ||
+      fstatat(chars.fd, name, &link_after, AT_SYMLINK_NOFOLLOW))
+    return -errno;
+  if (!S_ISDIR(linked.st_mode) || !SameInode(linked, target_stat) ||
+      !SameInode(link_before, link_after))
+    return -ENODEV;
+  PmsgFd device(open(node, O_WRONLY | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK));
+  if (device.fd < 0)
+    return -errno;
+  if (fstat(device.fd, &after) || lstat(node, &final_node))
+    return -errno;
+  if (!PmsgNodeMatches(before, after) || !PmsgNodeMatches(after, final_node))
+    return -EPERM;
+  // Kernel pmsg write ignores O_NONBLOCK: only this worker may call it.
+  int fd = device.fd;
+  device.fd = -1;
+  return fd;
+}
+int DiscoverPmsg(void *) { return OpenPmsgAt("/dev/pmsg0", "/sys"); }
+int Loop(int channel, unsigned duration, unsigned probe, Discover discover,
+         Validate validate, void *context, WriteFn writer, SyncFn syncer,
+         Discover pmsg_discover = nullptr, WriteFn pmsg_writer = nullptr) {
+  if (!pmsg_writer)
+    pmsg_writer = write;
+  std::string boot;
+  int e = ReadSmall("/proc/sys/kernel/random/boot_id", &boot, 64);
+  if (e)
+    return 2;
+  if (boot.size() == 37 && boot.back() == '\n')
+    boot.pop_back();
+  if (!ValidBootId(boot))
+    return 2;
+  const uint64_t start = NowNs();
+  if (!start)
+    return 2;
+  uint64_t next = start, next_pmsg = start;
+  const uint64_t end = start + uint64_t(duration) * 1000000ull;
+  std::array<Record, kMaxRecords> records{};
+  size_t count = 0, written = 0;
+  uint32_t last = 0;
+  unsigned checkpoints = 0;
+  int dir = -1, file = -1, result = 4;
+  bool eof = false, pmsg_disabled = pmsg_discover == nullptr;
+  int pmsg = -1;
+  size_t pmsg_sent = 0;
+  unsigned pmsg_attempts = 0, pmsg_probes = 0;
+  for (;;) {
+    for (unsigned i = 0; i < 32 && !eof; ++i) {
+      Record r{};
+      ssize_t n = recv(channel, r.data(), r.size(), MSG_DONTWAIT | MSG_TRUNC);
+      if (n < 0) {
+        if (errno == EAGAIN || errno == EWOULDBLOCK)
+          break;
+        result = 2;
+        goto done;
+      }
+      if (!n) {
+        eof = true;
+        break;
+      }
+      if (n != ssize_t(r.size()) || !ValidRecord(r) ||
+          RecordSequence(r) <= last) {
+        result = 2;
+        goto done;
+      }
+      last = RecordSequence(r);
+      if (count < records.size())
+        records[count++] = r;
+      else {
+        result = 3;
+        goto done;
+      }
+    }
+    uint64_t now = NowNs();
+    if (!now || now < start) {
+      result = 2;
+      goto done;
+    }
+    // Pre-cache sink: no filesystem checkpoint or later init event is needed.
+    // A blocked write can strand this worker, including its cache sink.
+    if (!pmsg_disabled && count > pmsg_sent) {
+      if (pmsg < 0 && now >= next_pmsg && pmsg_probes < 360) {
+        ++pmsg_probes;
+        next_pmsg = now + uint64_t(probe) * 1000000ull;
+        pmsg = pmsg_discover(context);
+        if (pmsg < 0 && pmsg != -ENOENT && pmsg != -EACCES)
+          pmsg_disabled = true;
+      }
+      if (pmsg >= 0) {
+        while (pmsg_sent < count && pmsg_attempts < kMaxPmsgFrames) {
+          auto frame = MakePmsgFrame(boot, records[pmsg_sent], ++pmsg_attempts);
+          if (!ValidPmsgFrame(frame.data(), frame.size()) ||
+              pmsg_writer(pmsg, frame.data(), frame.size()) !=
+                  ssize_t(frame.size())) {
+            pmsg_disabled = true;
+            break;
+          }
+          ++pmsg_sent;
+        }
+        if (pmsg_attempts >= kMaxPmsgFrames)
+          pmsg_disabled = true;
+        if (pmsg_disabled) {
+          close(pmsg);
+          pmsg = -1;
+        }
+      }
+    }
+    if (count > written && now >= next && checkpoints < kMaxCheckpoints) {
+      next = now + uint64_t(probe) * 1000000ull;
+      if (dir < 0)
+        dir = discover(context);
+      if (dir >= 0) {
+        if (!validate(dir, context)) {
+          result = 5;
+          goto done;
+        }
+        if (file < 0) {
+          file = OpenJournal(dir, boot, kBuild);
+          if (file < 0) {
+            result = 6;
+            goto done;
+          }
+        }
+        ++checkpoints;
+        struct stat st{};
+        if (fstat(file, &st) || st.st_uid != 0 || st.st_gid != 0 ||
+            st.st_nlink != 1) {
+          result = 6;
+          goto done;
+        }
+        e = AppendBatch(file, records.data() + written, count - written, writer,
+                        syncer);
+        if (e) {
+          result = 7;
+          goto done;
+        }
+        written = count;
+        next = now + uint64_t(duration / 24 > probe ? duration / 24 : probe) *
+                         1000000ull;
+        result = 0;
+      }
+    }
+    if (eof && written == count && count > 0) {
+      result = 0;
+      break;
+    }
+    if (now >= end) {
+      result = written == count && count > 0 ? 0 : 4;
+      break;
+    }
+    if (checkpoints >= kMaxCheckpoints) {
+      result = written == count ? 0 : 3;
+      break;
+    }
+    struct pollfd p{channel, POLLIN, 0};
+    int timeout = int((end - now) / 1000000ull);
+    if (timeout > 20)
+      timeout = 20;
+    if (timeout < 1)
+      timeout = 1;
+    // An EOF fd is never polled: otherwise POLLHUP creates an unbounded busy
+    // loop.
+    if (poll(eof ? nullptr : &p, eof ? 0 : 1, timeout) < 0 && errno != EINTR) {
+      result = 2;
+      break;
+    }
+  }
+done:
+  if (pmsg >= 0)
+    close(pmsg);
+  if (file >= 0)
+    close(file);
+  if (dir >= 0)
+    close(dir);
+  close(channel);
+  return result;
+}
+int ChildSetup(int channel, rlim_t file_limit, rlim_t cpu_limit,
+               const char *name) {
+  // This is called only in the single-threaded early child; never alter parent
+  // signals.
+  struct sigaction action{};
+  action.sa_handler = SIG_DFL;
+  sigemptyset(&action.sa_mask);
+  for (int s = 1; s < NSIG; ++s)
+    if (s != SIGKILL && s != SIGSTOP)
+      sigaction(s, &action, nullptr);
+  sigset_t set;
+  sigemptyset(&set);
+  if (sigprocmask(SIG_SETMASK, &set, nullptr))
+    return -errno;
+  if (channel >= 0 && channel != 3) {
+    if (dup3(channel, 3, O_CLOEXEC) < 0)
+      return -errno;
+    close(channel);
+  }
+  if (channel >= 0)
+    channel = 3;
+  DIR *list = opendir("/proc/self/fd");
+  if (!list)
+    return -errno;
+  int listfd = dirfd(list);
+  unsigned seen = 0;
+  int bad = 0;
+  for (;;) {
+    errno = 0;
+    auto entry = readdir(list);
+    if (!entry) {
+      bad = errno;
+      break;
+    }
+    if (entry->d_name[0] == '.')
+      continue;
+    if (++seen > 256) {
+      bad = E2BIG;
+      break;
+    }
+    char *end = nullptr;
+    long fd = strtol(entry->d_name, &end, 10);
+    if (!end || *end || fd < 0 || fd > INT_MAX) {
+      bad = EINVAL;
+      break;
+    }
+    if (fd > 2 && fd != channel && fd != listfd)
+      close(int(fd));
+  }
+  closedir(list);
+  if (bad)
+    return -bad;
+  struct rlimit files{32, 32}, size{file_limit, file_limit},
+      cpu{cpu_limit, cpu_limit};
+  if (setrlimit(RLIMIT_NOFILE, &files) || setrlimit(RLIMIT_FSIZE, &size) ||
+      setrlimit(RLIMIT_CPU, &cpu))
+    return -errno;
+  if (setpriority(PRIO_PROCESS, 0, 0))
+    return -errno;
+  prctl(PR_SET_NAME, name, 0, 0, 0);
+  alarm(kDurationMs / 1000);
+  return channel >= 0 ? channel : 0;
+}
+
+// Kernel-log copy for boots that reset without leaving a pstore record.
+// Logging only: bounded per file and per directory, and any failure just ends
+// this process. Kept out of the journal directory, whose reader accepts only
+// .journal names.
+constexpr char kKmsgDirectory[] = "trona-kmsg";
+constexpr size_t kKmsgMaxFiles = 6, kKmsgMaxBytes = 4 * 1024 * 1024,
+                 kKmsgRecordBytes = 8192;
+constexpr unsigned kKmsgFlushMs = 250, kKmsgWaitMs = 200;
+
+int DiscoverKmsgDir(void *) { return DiscoverCacheDir(kKmsgDirectory); }
+
+int KmsgOpenFile(int dir, const std::string &boot) {
+  int copy = dup(dir);
+  if (copy < 0)
+    return -errno;
+  DIR *list = fdopendir(copy);
+  if (!list) {
+    int e = -errno;
+    close(copy);
+    return e;
+  }
+  size_t files = 0;
+  while (auto entry = readdir(list))
+    if (entry->d_name[0] != '.')
+      ++files;
+  closedir(list);
+  if (files >= kKmsgMaxFiles)
+    return -ENOSPC;
+  std::string name = boot + ".kmsg";
+  int file = openat(dir, name.c_str(),
+                    O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC | O_NOFOLLOW, 0600);
+  return file < 0 ? -errno : file;
+}
+
+bool KmsgWriteAll(int file, const char *data, size_t size) {
+  while (size) {
+    ssize_t n = write(file, data, size);
+    if (n < 0 && errno == EINTR)
+      continue;
+    if (n <= 0)
+      return false;
+    data += n;
+    size -= size_t(n);
+  }
+  return true;
+}
+
+int KmsgLoop(int kmsg, Discover discover, void *context, unsigned duration,
+             unsigned wait) {
+  std::string boot;
+  if (ReadSmall("/proc/sys/kernel/random/boot_id", &boot, 64))
+    return 2;
+  if (boot.size() == 37 && boot.back() == '\n')
+    boot.pop_back();
+  if (!ValidBootId(boot))
+    return 2;
+  const uint64_t start = NowNs();
+  if (!start)
+    return 2;
+  const uint64_t end = start + uint64_t(duration) * 1000000ull;
+  // The kernel buffer keeps early messages, so waiting for /cache loses none.
+  int dir = -1;
+  for (;;) {
+    dir = discover(context);
+    if (dir >= 0)
+      break;
+    if (NowNs() >= end)
+      return 4;
+    poll(nullptr, 0, int(wait));
+  }
+  int file = KmsgOpenFile(dir, boot);
+  close(dir);
+  if (file < 0)
+    return 6;
+  static char buffer[65536];
+  size_t pending = 0, total = 0;
+  uint64_t next_flush = 0;
+  int result = 0;
+  for (;;) {
+    bool stop = false;
+    while (pending + kKmsgRecordBytes <= sizeof(buffer)) {
+      ssize_t n = read(kmsg, buffer + pending, kKmsgRecordBytes);
+      if (n > 0) {
+        pending += size_t(n);
+        continue;
+      }
+      if (n < 0 && errno == EPIPE) // Records were overwritten: keep reading.
+        continue;
+      if (n < 0 && errno == EINTR)
+        continue;
+      if (n < 0 && errno != EAGAIN && errno != EWOULDBLOCK) {
+        result = 2;
+        stop = true;
+      }
+      break;
+    }
+    uint64_t now = NowNs();
+    if (!now || now >= end)
+      stop = true;
+    bool full = pending + kKmsgRecordBytes > sizeof(buffer);
+    if (pending && (stop || full || now >= next_flush)) {
+      if (total + pending > kKmsgMaxBytes) {
+        result = 3;
+        break;
+      }
+      if (!KmsgWriteAll(file, buffer, pending) || fsync(file)) {
+        result = 7;
+        break;
+      }
+      total += pending;
+      pending = 0;
+      next_flush = now + uint64_t(kKmsgFlushMs) * 1000000ull;
+    }
+    if (stop)
+      break;
+    if (full)
+      continue;
+    struct pollfd p{kmsg, POLLIN, 0};
+    if (poll(&p, 1, 50) < 0 && errno != EINTR) {
+      result = 2;
+      break;
+    }
+    if (p.revents & (POLLHUP | POLLNVAL))
+      poll(nullptr, 0, 50);
+  }
+  close(file);
+  return result;
+}
+} // namespace
+bool IsInitThread(pid_t process, pid_t thread) {
+  return process == 1 && thread == 1;
+}
+void Start() {
+  int saved = errno;
+  if (!IsInitThread(getpid(), static_cast<pid_t>(syscall(SYS_gettid))) ||
+      producer.attempted) {
+    errno = saved;
+    return;
+  }
+  producer.attempted = true;
+  int s[2];
+  if (socketpair(AF_UNIX, SOCK_SEQPACKET | SOCK_NONBLOCK | SOCK_CLOEXEC, 0,
+                 s)) {
+    errno = saved;
+    return;
+  }
+  int buffer = 16384;
+  if (setsockopt(s[0], SOL_SOCKET, SO_SNDBUF, &buffer, sizeof(buffer))) {
+    close(s[0]);
+    close(s[1]);
+    errno = saved;
+    return;
+  }
+  pid_t child = fork();
+  if (child == 0) {
+    close(s[0]);
+    int fd = ChildSetup(s[1], kMaxJournalBytes, 5, "trona-recorder");
+    if (fd < 0)
+      _exit(8);
+    _exit(Loop(fd, kDurationMs, kProbeMs, DiscoverCache, ValidateCache, nullptr,
+               nullptr, nullptr, DiscoverPmsg, nullptr));
+  }
+  close(s[1]);
+  if (child < 0)
+    close(s[0]);
+  else
+    producer.fd = s[0];
+  if (fork() == 0) {
+    if (ChildSetup(-1, kKmsgMaxBytes, 30, "trona-kmsg") < 0)
+      _exit(8);
+    int kmsg = open("/dev/kmsg", O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+    if (kmsg < 0)
+      _exit(9);
+    _exit(KmsgLoop(kmsg, DiscoverKmsgDir, nullptr, kDurationMs, kKmsgWaitMs));
+  }
+  errno = saved;
+}
+uint32_t SourceId(const char *text) {
+  uint32_t hash = 2166136261u;
+  for (size_t n = 0; text && text[n] && n < 256; ++n) {
+    hash ^= static_cast<unsigned char>(text[n]);
+    hash *= 16777619u;
+  }
+  return hash;
+}
+void Mark(uint16_t event, uint32_t detail, int32_t status, uint32_t source,
+          uint32_t line) {
+  int saved = errno;
+  if (!IsInitThread(getpid(), static_cast<pid_t>(syscall(SYS_gettid))) ||
+      producer.fd < 0) {
+    errno = saved;
+    return;
+  }
+  if (producer.seq >= kMaxRecords) {
+    close(producer.fd);
+    producer.fd = -1;
+    errno = saved;
+    return;
+  }
+  if (producer.seq == kMaxRecords - 1) {
+    event = 65535;
+    detail = producer.seq;
+    status = -ENOSPC;
+  }
+  uint64_t now = NowNs();
+  auto record = MakeRecord(++producer.seq, producer.lost, event, now, detail,
+                           status, source, line);
+  int e = SendRecord(producer.fd, record);
+  if (e) {
+    if (producer.lost < UINT32_MAX)
+      ++producer.lost;
+    if (e != -EAGAIN && e != -EWOULDBLOCK) {
+      close(producer.fd);
+      producer.fd = -1;
+    }
+  }
+  errno = saved;
+}
+#ifdef TRONA_RECORDER_TEST
+namespace {
+int TestDiscover(void *context) {
+  int fd = *static_cast<int *>(context);
+  return fd < 0 ? -ENOENT : dup(fd);
+}
+bool TestValidate(int fd, void *context) {
+  struct stat a{}, b{};
+  return fstat(fd, &a) == 0 && fstat(*static_cast<int *>(context), &b) == 0 &&
+         a.st_ino == b.st_ino && a.st_dev == b.st_dev;
+}
+} // namespace
+int RunWorkerForTest(int channel, int directory, unsigned milliseconds,
+                     WriteFn writer, SyncFn syncer) {
+  return Loop(channel, milliseconds, 20, TestDiscover, TestValidate, &directory,
+              writer, syncer);
+}
+int RunKmsgForTest(int kmsg, int directory, unsigned milliseconds) {
+  return KmsgLoop(kmsg, TestDiscover, &directory, milliseconds, 10);
+}
+#endif
+} // namespace trona_recorder
