+            break;
+        case trona_recorder::Admission::kTableFullNow:
+            trona_recorder::Mark(trona_recorder::kServiceBudgetTableFull,
+                                 static_cast<uint32_t>(trona_recorder::kBudgetSlots), event, id, pid);
+            break;
+        case trona_recorder::Admission::kDrop:
+            break;
+    }
