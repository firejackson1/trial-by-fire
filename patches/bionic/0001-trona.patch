+// trona: executables built for API 30 or older (this tablet's retained Android 11 vendor)
+// predate fatal-by-default fdsan; stock Android 11 libc defaulted to WARN_ONCE. Everything
+// built for a newer API, and any explicit debug.fdsan setting, is unchanged.
+static android_fdsan_error_level __fdsan_default_level_for_executable() {
+  const auto* phdr = reinterpret_cast<const ElfW(Phdr)*>(getauxval(AT_PHDR));
+  size_t phnum = getauxval(AT_PHNUM);
+  if (phdr == nullptr || phnum == 0) return ANDROID_FDSAN_ERROR_LEVEL_FATAL;
+  ElfW(Addr) load_bias = 0;
+  bool have_bias = false;
+  for (size_t i = 0; i < phnum; ++i) {
+    if (phdr[i].p_type == PT_PHDR) {
+      load_bias = reinterpret_cast<ElfW(Addr)>(phdr) - phdr[i].p_vaddr;
+      have_bias = true;
+      break;
+    }
+  }
+  if (!have_bias) return ANDROID_FDSAN_ERROR_LEVEL_FATAL;
+  for (size_t i = 0; i < phnum; ++i) {
+    if (phdr[i].p_type != PT_NOTE) continue;
+    ElfW(Addr) p = load_bias + phdr[i].p_vaddr;
+    ElfW(Addr) end = p + phdr[i].p_memsz;
+    while (p + sizeof(ElfW(Nhdr)) <= end) {
+      const auto* nh = reinterpret_cast<const ElfW(Nhdr)*>(p);
+      ElfW(Addr) name = p + sizeof(ElfW(Nhdr));
+      ElfW(Addr) desc = name + __builtin_align_up(nh->n_namesz, 4);
+      ElfW(Addr) next = desc + __builtin_align_up(nh->n_descsz, 4);
+      if (next > end || next <= p) break;
+      if (nh->n_type == NT_ANDROID_TYPE_IDENT && nh->n_namesz == 8 &&
+          memcmp(reinterpret_cast<const char*>(name), "Android", 8) == 0 && nh->n_descsz >= 4) {
+        int32_t api;
+        memcpy(&api, reinterpret_cast<const void*>(desc), sizeof(api));
+        return (api > 0 && api <= 30) ? ANDROID_FDSAN_ERROR_LEVEL_WARN_ONCE
+                                      : ANDROID_FDSAN_ERROR_LEVEL_FATAL;
+      }
+      p = next;
+    }
+  }
+  return ANDROID_FDSAN_ERROR_LEVEL_FATAL;
+}
+
 void __libc_init_fdsan() {
-  constexpr auto default_level = ANDROID_FDSAN_ERROR_LEVEL_FATAL;
-  android_fdsan_set_error_level_from_property(default_level);
+  android_fdsan_set_error_level_from_property(__fdsan_default_level_for_executable());
 }
 
