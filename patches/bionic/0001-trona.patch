diff --git a/libc/upstream-openbsd/lib/libc/crypt/arc4random.c b/libc/upstream-openbsd/lib/libc/crypt/arc4random.c
index 0737cf3..68ace6d 100644
--- a/libc/upstream-openbsd/lib/libc/crypt/arc4random.c
+++ b/libc/upstream-openbsd/lib/libc/crypt/arc4random.c
@@ -23,6 +23,45 @@
  * ChaCha based random number generator for OpenBSD.
  */
 
+#if defined(TRONA_KERNEL_ENTROPY_ONLY)
+// Dedicated development product: fresh kernel CSPRNG bytes for every request.
+// No userspace PRNG state survives fork. Flags0 waits for initialized entropy.
+#include <errno.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <sys/random.h>
+#include <async_safe/log.h>
+static pthread_mutex_t g_arc4random_mutex = PTHREAD_MUTEX_INITIALIZER;
+void arc4random_mutex_lock(void) { pthread_mutex_lock(&g_arc4random_mutex); }
+void arc4random_mutex_unlock(void) { pthread_mutex_unlock(&g_arc4random_mutex); }
+static void trona_kernel_entropy(void* output, size_t remaining) {
+  const int saved_errno = errno;
+  unsigned char* cursor = output;
+  while (remaining != 0) {
+    const size_t request = remaining > 256 ? 256 : remaining;
+    const ssize_t result = getrandom(cursor, request, 0);
+    if (result == -1 && errno == EINTR) continue;
+    if (result <= 0 || (size_t)result > request) {
+      if (result >= 0) errno = EIO;
+      async_safe_fatal("kernel entropy read failed: %m");
+    }
+    cursor += result;
+    remaining -= result;
+  }
+  errno = saved_errno;
+}
+uint32_t arc4random(void) {
+  uint32_t result;
+  trona_kernel_entropy(&result, sizeof(result));
+  return result;
+}
+DEF_WEAK(arc4random);
+void arc4random_buf(void* buffer, size_t size) {
+  trona_kernel_entropy(buffer, size);
+}
+DEF_WEAK(arc4random_buf);
+#else
 #include <fcntl.h>
 #include <limits.h>
 #include <signal.h>
@@ -202,3 +241,5 @@ arc4random_buf(void *buf, size_t n)
 	_ARC4_UNLOCK();
 }
 DEF_WEAK(arc4random_buf);
+
+#endif // TRONA_KERNEL_ENTROPY_ONLY
