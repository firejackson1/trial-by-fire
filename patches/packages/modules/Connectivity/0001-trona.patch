diff --git a/service-t/jni/trona/LegacyQtaguidStats.cpp b/service-t/jni/trona/LegacyQtaguidStats.cpp
new file mode 100644
index 0000000..5922959
--- /dev/null
+++ b/service-t/jni/trona/LegacyQtaguidStats.cpp
@@ -0,0 +1,138 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "LegacyQtaguidStats.h"
+#include <array>
+#include <cerrno>
+#include <charconv>
+#include <cstring>
+#include <locale>
+#include <sstream>
+#include <string_view>
+#include <utility>
+
+namespace trona::network {
+namespace {
+template <typename T> bool decimal(std::string_view text, T* output) {
+    if (text.empty() || text[0] == '-' || text[0] == '+') return false;
+    const auto end = text.data() + text.size();
+    const auto result = std::from_chars(text.data(), end, *output, 10);
+    return result.ec == std::errc{} && result.ptr == end;
+}
+
+template <size_t N> bool fields(const std::string& line, std::array<std::string, N>* values) {
+    std::istringstream stream(line);
+    stream.imbue(std::locale::classic());
+    for (auto& value : *values) if (!(stream >> value)) return false;
+    // Kernel TCP/UDP/other breakdown columns are not part of the returned totals.
+    return true;
+}
+
+bool tag(std::string_view text, int32_t* output, uint64_t* rawOutput) {
+    if (text.size() < 3 || text[0] != '0' || (text[1] != 'x' && text[1] != 'X')) return false;
+    text.remove_prefix(2);
+    uint64_t combined;
+    const auto end = text.data() + text.size();
+    const auto result = std::from_chars(text.data(), end, combined, 16);
+    if (result.ec != std::errc{} || result.ptr != end) return false;
+    // Match NetworkStatsFactory.kernelToTag: upper 32 bits, retaining signed
+    // Android tag bit patterns (for example 0xffffff01 -> -255).
+    const uint32_t upper = combined >> 32;
+    static_assert(sizeof(upper) == sizeof(*output));
+    std::memcpy(output, &upper, sizeof(upper));
+    *rawOutput = combined;
+    return true;
+}
+}  // namespace
+
+int ReadQtaguidStats(std::istream& input, std::vector<QtaguidStatsEntry>* output) {
+    if (!output || input.exceptions() != std::ios::goodbit) return -EINVAL;
+    std::string line;
+    if (!std::getline(input, line)) return input.bad() ? -EIO : -EPROTO;
+    std::array<std::string, 9> values;
+    const std::array<std::string, 9> expected = {"idx", "iface", "acct_tag_hex", "uid_tag_int",
+            "cnt_set", "rx_bytes", "rx_packets", "tx_bytes", "tx_packets"};
+    if (!fields(line, &values) || values != expected) return -EPROTO;
+    uint64_t previous = 1;
+    std::vector<QtaguidStatsEntry> parsed;
+    while (std::getline(input, line)) {
+        if (!fields(line, &values)) return -EPROTO;
+        uint64_t index;
+        QtaguidStatsEntry entry{};
+        if (!decimal(values[0], &index) || previous == UINT64_MAX || index != previous + 1
+                || values[1].empty() || values[1].size() >= 32
+                || values[1].find('\0') != std::string::npos
+                || !tag(values[2], &entry.tag, &entry.rawTag) || !decimal(values[3], &entry.uid)
+                || !decimal(values[4], &entry.set) || !decimal(values[5], &entry.rxBytes)
+                || !decimal(values[6], &entry.rxPackets) || !decimal(values[7], &entry.txBytes)
+                || !decimal(values[8], &entry.txPackets)) return -EPROTO;
+        previous = index;
+        entry.iface = values[1];
+        parsed.push_back(std::move(entry));
+    }
+    if (input.bad() || (!input.eof() && input.fail())) return -EIO;
+    output->swap(parsed);
+    return 0;
+}
+}  // namespace trona::network
+
+namespace trona::network {
+namespace {
+bool ifaceCounters(std::istringstream& row, std::array<int64_t, 4>* counters) {
+    std::string field;
+    for (auto& counter : *counters) {
+        if (!(row >> field) || !decimal(field, &counter)) return false;
+    }
+    return true;
+}
+}  // namespace
+
+int ReadQtaguidIfaceStats(std::istream& input, QtaguidIfaceFormat format,
+                         std::vector<QtaguidStatsEntry>* output) {
+    if (!output || input.exceptions() != std::ios::goodbit
+            || (format != QtaguidIfaceFormat::All && format != QtaguidIfaceFormat::Formatted)) {
+        return -EINVAL;
+    }
+    std::string line;
+    if (format == QtaguidIfaceFormat::Formatted) {
+        if (!std::getline(input, line)) return input.bad() ? -EIO : -EPROTO;
+        std::array<std::string, 5> names;
+        const std::array<std::string, 5> expected = {"ifname", "total_skb_rx_bytes",
+                "total_skb_rx_packets", "total_skb_tx_bytes", "total_skb_tx_packets"};
+        if (!fields(line, &names) || names != expected) return -EPROTO;
+    }
+    std::vector<QtaguidStatsEntry> parsed;
+    while (std::getline(input, line)) {
+        std::istringstream row(line);
+        row.imbue(std::locale::classic());
+        QtaguidStatsEntry entry{};
+        entry.uid = -1;  // NetworkStats.UID_ALL
+        entry.set = -1;  // NetworkStats.SET_ALL
+        if (!(row >> entry.iface) || entry.iface.size() >= 32
+                || entry.iface.find('\0') != std::string::npos) return -EPROTO;
+        int32_t active = 0;
+        if (format == QtaguidIfaceFormat::All) {
+            std::string field;
+            if (!(row >> field) || !decimal(field, &active)) return -EPROTO;
+        }
+        std::array<int64_t, 4> counters;
+        if (!ifaceCounters(row, &counters)) return -EPROTO;
+        if (active != 0) {
+            std::array<int64_t, 4> live;
+            if (!ifaceCounters(row, &live)) return -EPROTO;
+            for (size_t i = 0; i < counters.size(); ++i) {
+                if (live[i] > INT64_MAX - counters[i]) return -EOVERFLOW;
+                counters[i] += live[i];
+            }
+        }
+        // As in the legacy platform reader, ignore extra columns, including
+        // live counters on inactive interfaces. Never add those twice.
+        entry.rxBytes = counters[0];
+        entry.rxPackets = counters[1];
+        entry.txBytes = counters[2];
+        entry.txPackets = counters[3];
+        parsed.push_back(std::move(entry));
+    }
+    if (input.bad() || (!input.eof() && input.fail())) return -EIO;
+    output->swap(parsed);
+    return 0;
+}
+}  // namespace trona::network
diff --git a/service-t/jni/trona/LegacyQtaguidStats.h b/service-t/jni/trona/LegacyQtaguidStats.h
new file mode 100644
index 0000000..1fb8a3a
--- /dev/null
+++ b/service-t/jni/trona/LegacyQtaguidStats.h
@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <cstdint>
+#include <istream>
+#include <string>
+#include <vector>
+
+namespace trona::network {
+// Raw cumulative counters. These are NOT the incremental BPF samples consumed by
+// Android 17 NetworkStatsFactory. No reset/delta, VPN, CLAT, or filtering here.
+struct QtaguidStatsEntry {
+    std::string iface;
+    int32_t uid;
+    int32_t set;
+    int32_t tag;
+    int64_t rxBytes;
+    int64_t rxPackets;
+    int64_t txBytes;
+    int64_t txPackets;
+    // Keep the complete proc tag for consumers (TrafficStats) that test raw
+    // tag zero. NetworkStats uses the separate signed upper-32-bit tag above.
+    uint64_t rawTag = 0;
+};
+
+// Parse the standard xt_qtaguid stats text. Publish a complete result only on
+// success. Return negative errno on malformed input/read failure; never replace
+// the caller's previous data with an empty or partial successful snapshot.
+// An empty, valid header-only snapshot is legitimate. Caller owns/opened the stream
+// and must leave its exception mask disabled (Android builds without exceptions).
+int ReadQtaguidStats(std::istream& input, std::vector<QtaguidStatsEntry>* output);
+
+enum class QtaguidIfaceFormat { All, Formatted };
+
+// Interface totals use UID_ALL/SET_ALL (-1) and TAG_NONE (0). All is the
+// headerless iface_stat_all format: saved counters plus live counters only when
+// active. Formatted is iface_stat_fmt (IP-layer totals with a header).
+// Same stream/error/publication contract as ReadQtaguidStats; no file is opened.
+int ReadQtaguidIfaceStats(std::istream& input, QtaguidIfaceFormat format,
+                         std::vector<QtaguidStatsEntry>* output);
+}  // namespace trona::network
diff --git a/service-t/jni/trona/LegacyTrafficStats.cpp b/service-t/jni/trona/LegacyTrafficStats.cpp
new file mode 100644
index 0000000..9b7faee
--- /dev/null
+++ b/service-t/jni/trona/LegacyTrafficStats.cpp
@@ -0,0 +1,49 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "LegacyTrafficStats.h"
+#include "LegacyQtaguidStats.h"
+#include <cerrno>
+#include <limits>
+
+namespace trona::network {
+namespace {
+bool addCounters(QtaguidTrafficStats& sum, const QtaguidStatsEntry& row) {
+    constexpr int64_t max = std::numeric_limits<int64_t>::max();
+    if (row.rxBytes > max - sum.rxBytes || row.rxPackets > max - sum.rxPackets
+            || row.txBytes > max - sum.txBytes || row.txPackets > max - sum.txPackets) {
+        return false;
+    }
+    sum.rxBytes += row.rxBytes;
+    sum.rxPackets += row.rxPackets;
+    sum.txBytes += row.txBytes;
+    sum.txPackets += row.txPackets;
+    return true;
+}
+}  // namespace
+
+int ReadQtaguidUidTrafficStats(std::istream& input, int32_t uid, QtaguidTrafficStats* output) {
+    if (!output || uid < 0) return -EINVAL;
+    std::vector<QtaguidStatsEntry> rows;
+    const int result = ReadQtaguidStats(input, &rows);
+    if (result != 0) return result;
+    QtaguidTrafficStats sum{};
+    for (const auto& row : rows) {
+        if (row.uid == uid && row.rawTag == 0 && !addCounters(sum, row)) return -EOVERFLOW;
+    }
+    *output = sum;
+    return 0;
+}
+
+int ReadQtaguidIfaceTrafficStats(std::istream& input, const char* iface,
+                               QtaguidTrafficStats* output) {
+    if (!output) return -EINVAL;
+    std::vector<QtaguidStatsEntry> rows;
+    const int result = ReadQtaguidIfaceStats(input, QtaguidIfaceFormat::Formatted, &rows);
+    if (result != 0) return result;
+    QtaguidTrafficStats sum{};
+    for (const auto& row : rows) {
+        if ((!iface || row.iface == iface) && !addCounters(sum, row)) return -EOVERFLOW;
+    }
+    *output = sum;
+    return 0;
+}
+}  // namespace trona::network
