+    // so do not rely on its deprecated implicit copy constructor during growth.
+    std::vector<stats_line> lines(parsed.size());
+    for (size_t i = 0; i < parsed.size(); ++i) {
+        const auto& entry = parsed[i];
+        auto& line = lines[i];
+        // The parser has checked the destination's 32-byte interface bound.
+        std::memcpy(line.iface, entry.iface.c_str(), entry.iface.size() + 1);
+        line.uid = static_cast<uint32_t>(entry.uid);
+        line.set = static_cast<uint32_t>(entry.set);
+        line.tag = static_cast<uint32_t>(entry.tag);
+        line.rxBytes = entry.rxBytes;
+        line.rxPackets = entry.rxPackets;
+        line.txBytes = entry.txBytes;
+        line.txPackets = entry.txPackets;
+    }
+    return statsLinesToNetworkStats(env, clazz, stats, lines, true);
+}
