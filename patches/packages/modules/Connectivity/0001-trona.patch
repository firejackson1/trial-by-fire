+// SPDX-License-Identifier: Apache-2.0
+#include <cerrno>
+#include <nativehelper/JNIHelp.h>
+#include <trona/NativeNetworkProfile.h>
+namespace android {
+static jint getRequestedBackend(JNIEnv*, jclass) {
+    using trona::network::RequestedNetworkBackend;
+    RequestedNetworkBackend backend;
+    const int result = trona::network::GetRequestedNetworkBackend(&backend);
+    if (result != 0) return result < 0 ? result : -EIO;
+    switch (backend) {
+        case RequestedNetworkBackend::Modern: return 0;
+        case RequestedNetworkBackend::TronaLegacy: return 1;
+    }
+    return -EPROTO;
+}
+static jint requireLegacyNativeReady(JNIEnv*, jclass) {
+    const int result = trona::network::RequireLegacyNativeReady();
+    return result <= 0 ? result : -EIO;
+}
+static const JNINativeMethod methods[] = {
+        {const_cast<char*>("nativeGetRequestedBackend"), const_cast<char*>("()I"),
+                (void*)getRequestedBackend},
+        {const_cast<char*>("nativeRequireLegacyNativeReady"), const_cast<char*>("()I"),
+                (void*)requireLegacyNativeReady},
+};
+int register_com_android_server_connectivity_TronaNetworkProfile(JNIEnv* env) {
+    return jniRegisterNativeMethods(env,
+            "android/net/connectivity/com/android/server/connectivity/TronaNetworkProfile",
+            methods, sizeof(methods) / sizeof(methods[0]));
+}
+}
