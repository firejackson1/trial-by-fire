diff --git a/service/src/com/android/server/connectivity/TronaNetworkProfile.java b/service/src/com/android/server/connectivity/TronaNetworkProfile.java
new file mode 100644
index 0000000..a14e4da
--- /dev/null
+++ b/service/src/com/android/server/connectivity/TronaNetworkProfile.java
@@ -0,0 +1,28 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.android.server.connectivity;
+import android.os.ServiceSpecificException;
+
+/** Read-only frozen native request. A requested backend is not readiness. */
+public final class TronaNetworkProfile {
+    public enum Backend { MODERN, TRONA_LEGACY }
+    private TronaNetworkProfile() {}
+    // JNI can load/register this outer class without invoking any native method.
+    private static final class Requested {
+        static final int VALUE = nativeGetRequestedBackend();
+    }
+    public static Backend getRequestedBackend() {
+        final int value = Requested.VALUE;
+        if (value < 0) throw new ServiceSpecificException(-value, "Invalid native network profile");
+        if (value == 0) return Backend.MODERN;
+        if (value == 1) return Backend.TRONA_LEGACY;
+        throw new IllegalStateException("Invalid native profile value: " + value);
+    }
+    /** Fresh check only; publishes nothing and creates no UID owner. */
+    public static void requireLegacyNativeReady() {
+        final int result = nativeRequireLegacyNativeReady();
+        if (result < 0) throw new ServiceSpecificException(-result, "Legacy native core unavailable");
+        if (result != 0) throw new IllegalStateException("Invalid ready status: " + result);
+    }
+    private static native int nativeGetRequestedBackend();
+    private static native int nativeRequireLegacyNativeReady();
+}
