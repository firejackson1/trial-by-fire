@@ -0,0 +1,366 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.android.server.connectivity;
+
+import static android.net.ConnectivityManager.FIREWALL_CHAIN_BACKGROUND;
+import static android.net.ConnectivityManager.FIREWALL_CHAIN_DOZABLE;
+import static android.net.ConnectivityManager.FIREWALL_CHAIN_LOW_POWER_STANDBY;
+import static android.net.ConnectivityManager.FIREWALL_CHAIN_METERED_ALLOW;
+import static android.net.ConnectivityManager.FIREWALL_CHAIN_METERED_DENY_ADMIN;
+import static android.net.ConnectivityManager.FIREWALL_CHAIN_METERED_DENY_USER;
+import static android.net.ConnectivityManager.FIREWALL_CHAIN_OEM_DENY_1;
+import static android.net.ConnectivityManager.FIREWALL_CHAIN_OEM_DENY_2;
+import static android.net.ConnectivityManager.FIREWALL_CHAIN_OEM_DENY_3;
+import static android.net.ConnectivityManager.FIREWALL_CHAIN_POWERSAVE;
+import static android.net.ConnectivityManager.FIREWALL_CHAIN_RESTRICTED;
+import static android.net.ConnectivityManager.FIREWALL_CHAIN_STANDBY;
+import static android.net.ConnectivityManager.FIREWALL_RULE_ALLOW;
+import static android.net.ConnectivityManager.FIREWALL_RULE_DENY;
+
+import static android.net.ConnectivityManager.BLOCKED_REASON_NONE;
+import static android.net.ConnectivityManager.BLOCKED_REASON_BATTERY_SAVER;
+import static android.net.ConnectivityManager.BLOCKED_REASON_DOZE;
+import static android.net.ConnectivityManager.BLOCKED_REASON_APP_STANDBY;
+import static android.net.ConnectivityManager.BLOCKED_REASON_RESTRICTED_MODE;
+import static android.net.ConnectivityManager.BLOCKED_REASON_LOW_POWER_STANDBY;
+import static android.net.ConnectivityManager.BLOCKED_REASON_APP_BACKGROUND;
+import static android.net.ConnectivityManager.BLOCKED_REASON_OEM_DENY;
+import static android.net.ConnectivityManager.BLOCKED_METERED_REASON_USER_RESTRICTED;
+import static android.net.ConnectivityManager.BLOCKED_METERED_REASON_ADMIN_DISABLED;
+import static android.net.ConnectivityManager.BLOCKED_METERED_REASON_DATA_SAVER;
+import static android.system.OsConstants.EPROTO;
+
+import android.os.RemoteException;
+import android.os.Process;
+import android.os.UserHandle;
+import android.os.ServiceSpecificException;
+import com.android.internal.net.TronaUidBlockedStatus;
+import com.android.internal.net.IOemNetd;
+import com.android.internal.net.TronaUidChain;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Set;
+import java.util.TreeMap;
+import java.util.TreeSet;
+
+/**
+ * Device-local nonmetered and metered membership client, staged for Connectivity integration.
+ *
+ * One instance must exclusively own the native UID backend. The creator supplies
+ * the complete active-user set and a selected OEM endpoint; construction performs
+ * full empty-policy replay to both snapshots and propagates any backend error. Construct
+ * only for a fresh startup before policy activation and framework policy
+ * reconstruction, never to attach to an already active policy. No backend
+ * selection, parent hook, BPF bypass, Binder reconnection or Data Saver policy is
+ * provided here. Netd's existing zygote restart contract reconstructs system_server.
+ *
+ * State is published only after acknowledgement. Any transport/service failure may
+ * follow a partial native commit: retain the last acknowledged snapshot and replay
+ * it before another operation, including an otherwise-idempotent call or query.
+ * Both snapshots must ACK before the cache is known; no cross-RPC atomicity is claimed.
+ * The failing call still throws; no error is reported as success.
+ * The caller must translate RemoteException to its framework API error contract.
+ * User snapshots are authoritative lifecycle facts: failed updates remain pending
+ * and must reconcile before later policy work. Removed users lose cached UID
+ * memberships, including when a user ID is reused before acknowledgement.
+ * New membership for an inactive user is rejected; late cleanup is still allowed.
+ * User IDs alone cannot identify delayed writes from an older incarnation after
+ * ID reuse. The lifecycle caller must provide ordering/generation protection.
+ */
+public final class TronaUidPolicy {
+    private final IOemNetd mBackend;
+    // All mutable state and RPCs are serialized by this instance's monitor.
+    private Map<Integer, Set<Integer>> mMembers = new TreeMap<>();
+    private Set<Integer> mUsers;
+    private Set<Integer> mPendingUsers;
+    private final Set<Integer> mRemovedUsers = new TreeSet<>();
+    // Matches Android UID arithmetic and the native dispatch builder.
+    private static final int UIDS_PER_USER = 100_000;
+    private final Set<Integer> mEnabled = new TreeSet<>();
+    private boolean mKnown;
+
+    public TronaUidPolicy(IOemNetd backend, int[] activeUsers) throws RemoteException {
+        mBackend = Objects.requireNonNull(backend);
+        mUsers = checkedUsers(activeUsers);
+        for (int chain : new int[] {FIREWALL_CHAIN_DOZABLE, FIREWALL_CHAIN_STANDBY,
+                FIREWALL_CHAIN_POWERSAVE, FIREWALL_CHAIN_RESTRICTED,
+                FIREWALL_CHAIN_LOW_POWER_STANDBY, FIREWALL_CHAIN_BACKGROUND,
+                FIREWALL_CHAIN_OEM_DENY_1, FIREWALL_CHAIN_OEM_DENY_2,
+                FIREWALL_CHAIN_OEM_DENY_3, FIREWALL_CHAIN_METERED_ALLOW,
+                FIREWALL_CHAIN_METERED_DENY_USER, FIREWALL_CHAIN_METERED_DENY_ADMIN}) {
+            mMembers.put(chain, new TreeSet<>());
+        }
+        replay();
+    }
+
+    private static boolean isAllowChain(int chain) {
+        switch (chain) {
+            case FIREWALL_CHAIN_DOZABLE:
+            case FIREWALL_CHAIN_POWERSAVE:
+            case FIREWALL_CHAIN_RESTRICTED:
+            case FIREWALL_CHAIN_LOW_POWER_STANDBY:
+            case FIREWALL_CHAIN_BACKGROUND:
+                return true;
+            case FIREWALL_CHAIN_STANDBY:
+            case FIREWALL_CHAIN_OEM_DENY_1:
+            case FIREWALL_CHAIN_OEM_DENY_2:
+            case FIREWALL_CHAIN_OEM_DENY_3:
+                return false;
+            case FIREWALL_CHAIN_METERED_ALLOW:
+                return true;
+            case FIREWALL_CHAIN_METERED_DENY_USER:
+            case FIREWALL_CHAIN_METERED_DENY_ADMIN:
+                return false;
+            default:
+                throw new IllegalArgumentException("Invalid firewall chain: " + chain);
+        }
+    }
+
+    private static boolean isMeteredChain(int chain) {
+        return chain == FIREWALL_CHAIN_METERED_ALLOW
+                || chain == FIREWALL_CHAIN_METERED_DENY_USER
+                || chain == FIREWALL_CHAIN_METERED_DENY_ADMIN;
+    }
+
+    private static void checkUid(int uid) {
+        if (uid < 0) throw new IllegalArgumentException("Negative UID: " + uid);
+    }
+
+    private void checkMemberUser(int uid) {
+        Set<Integer> current = mPendingUsers != null ? mPendingUsers : mUsers;
+        if (!current.contains(uid / UIDS_PER_USER)) {
+            throw new IllegalArgumentException("Inactive user for UID: " + uid);
+        }
+    }
+
+    private static Set<Integer> checkedUsers(int[] users) {
+        Set<Integer> result = new TreeSet<>();
+        for (int user : Objects.requireNonNull(users)) {
+            // Same bounded UID-range arithmetic as the native dispatch builder.
+            if (user < 0 || user > 21474) throw new IllegalArgumentException("Invalid user: " + user);
+            result.add(user);
+        }
+        if (!result.contains(0)) throw new IllegalArgumentException("Missing system user");
+        return result;
+    }
+
+    private static int[] array(Set<Integer> values) {
+        return values.stream().mapToInt(Integer::intValue).toArray();
+    }
+
+    private interface Call<T> { T run() throws RemoteException; }
+
+    private <T> T invoke(Call<T> call) throws RemoteException {
+        try {
+            return call.run();
+        } catch (RemoteException | RuntimeException error) {
+            mKnown = false;
+            throw error;
+        }
+    }
+
+    private void restore(Set<Integer> users, Map<Integer, Set<Integer>> members)
+            throws RemoteException {
+        List<TronaUidChain> chains = new ArrayList<>();
+        for (Map.Entry<Integer, Set<Integer>> entry : members.entrySet()) {
+            if (isMeteredChain(entry.getKey())) continue;
+            TronaUidChain chain = new TronaUidChain();
+            chain.chain = entry.getKey();
+            chain.uids = array(entry.getValue());
+            chains.add(chain);
+        }
+        invoke(() -> {
+            mBackend.replaceTronaUidPolicy(array(users), chains.toArray(new TronaUidChain[0]),
+                    array(mEnabled));
+            mBackend.replaceTronaMeteredPolicy(array(users),
+                    array(members.get(FIREWALL_CHAIN_METERED_ALLOW)),
+                    array(members.get(FIREWALL_CHAIN_METERED_DENY_USER)),
+                    array(members.get(FIREWALL_CHAIN_METERED_DENY_ADMIN)));
+            return null;
+        });
+        mKnown = true;
+    }
+
+    /** Reconcile authoritative users first, otherwise the last acknowledged policy. */
+    public synchronized void replay() throws RemoteException {
+        if (mPendingUsers != null) applyPendingUsers();
+        else restore(mUsers, mMembers);
+    }
+
+    private void ensureReplayed() throws RemoteException {
+        if (mPendingUsers != null || !mKnown) replay();
+    }
+
+    private void applyPendingUsers() throws RemoteException {
+        if (mPendingUsers == null) return;
+        Map<Integer, Set<Integer>> retained = new TreeMap<>();
+        for (Map.Entry<Integer, Set<Integer>> entry : mMembers.entrySet()) {
+            Set<Integer> uids = new TreeSet<>();
+            for (int uid : entry.getValue()) {
+                int user = uid / UIDS_PER_USER;
+                if (mPendingUsers.contains(user) && !mRemovedUsers.contains(user)) uids.add(uid);
+            }
+            retained.put(entry.getKey(), uids);
+        }
+        restore(mPendingUsers, retained);
+        mUsers = mPendingUsers;
+        mMembers = retained;
+        mPendingUsers = null;
+        mRemovedUsers.clear();
+    }
+
+    /** Apply the complete current user set; failures block subsequent policy calls until replay. */
+    public synchronized void replaceUsers(int[] activeUsers) throws RemoteException {
+        replaceUsersInternal(activeUsers, null);
+    }
+
+    /** Record removal plus the full current snapshot as one durable pending intent. */
+    public synchronized void replaceUsersAfterRemoval(int[] activeUsers, int removedUser)
+            throws RemoteException {
+        if (removedUser <= 0 || removedUser > 21474) {
+            throw new IllegalArgumentException("Invalid removed user: " + removedUser);
+        }
+        replaceUsersInternal(activeUsers, removedUser);
+    }
+
+    // Called under this instance's monitor. No RPC occurs before both facts are pending.
+    private void replaceUsersInternal(int[] activeUsers, Integer removedUser) throws RemoteException {
+        Set<Integer> candidate = checkedUsers(activeUsers);
+        Set<Integer> previous = mPendingUsers != null ? mPendingUsers : mUsers;
+        for (int user : previous) {
+            if (!candidate.contains(user)) mRemovedUsers.add(user);
+        }
+        // Keep removal history until acknowledgement so remove/re-add cannot revive
+        // old policy when the first restore had an ambiguous result.
+        if (removedUser != null) mRemovedUsers.add(removedUser);
+        mPendingUsers = candidate;
+        applyPendingUsers();
+    }
+
+    public synchronized void replaceUidChain(int chain, int[] uids) throws RemoteException {
+        isAllowChain(chain);
+        Set<Integer> replacement = new TreeSet<>();
+        for (int uid : Objects.requireNonNull(uids)) {
+            checkUid(uid);
+            checkMemberUser(uid);
+            replacement.add(uid);
+        }
+        applyPendingUsers();
+        Map<Integer, Set<Integer>> candidate = new TreeMap<>(mMembers);
+        candidate.put(chain, replacement);
+        restore(mUsers, candidate);
+        mMembers = candidate;
+    }
+
+    public synchronized void setUidRule(int chain, int uid, int rule) throws RemoteException {
+        boolean allowChain = isAllowChain(chain);
+        checkUid(uid);
+        if (rule != FIREWALL_RULE_ALLOW && rule != FIREWALL_RULE_DENY) {
+            throw new IllegalArgumentException("Invalid rule: " + rule);
+        }
+        boolean member = allowChain == (rule == FIREWALL_RULE_ALLOW);
+        if (member) checkMemberUser(uid);
+        ensureReplayed();
+        Set<Integer> members = mMembers.get(chain);
+        if (members.contains(uid) == member) return;
+        invoke(() -> {
+            if (isMeteredChain(chain)) mBackend.setTronaMeteredUidRule(chain, uid, rule);
+            else mBackend.setTronaUidRule(chain, uid, rule);
+            return null;
+        });
+        if (member) members.add(uid); else members.remove(uid);
+    }
+
+    public synchronized int getUidRule(int chain, int uid) throws RemoteException {
+        isAllowChain(chain);
+        checkUid(uid);
+        ensureReplayed();
+        return invoke(() -> isMeteredChain(chain)
+                ? mBackend.getTronaMeteredUidRule(chain, uid)
+                : mBackend.getTronaUidRule(chain, uid));
+    }
+
+    public synchronized void setChildChain(int chain, boolean enabled) throws RemoteException {
+        isAllowChain(chain);
+        if (isMeteredChain(chain)) {
+            throw new UnsupportedOperationException("Metered chain has no child enable state: " + chain);
+        }
+        ensureReplayed();
+        if (mEnabled.contains(chain) == enabled) return;
+        invoke(() -> { mBackend.setTronaChildChain(chain, enabled); return null; });
+        if (enabled) mEnabled.add(chain); else mEnabled.remove(chain);
+    }
+
+    public synchronized boolean isChainEnabled(int chain) throws RemoteException {
+        isAllowChain(chain);
+        if (isMeteredChain(chain)) {
+            throw new UnsupportedOperationException("Metered chain has no child enable state: " + chain);
+        }
+        ensureReplayed();
+        return invoke(() -> mBackend.isTronaChildChainEnabled(chain));
+    }
+
+    private static Set<Integer> checkedSnapshotChains(int[] chains, boolean enabled) {
+        if (chains == null) throw new ServiceSpecificException(EPROTO, "Missing chain array");
+        Set<Integer> result = new TreeSet<>();
+        for (int chain : chains) {
+            try {
+                isAllowChain(chain);
+            } catch (IllegalArgumentException error) {
+                throw new ServiceSpecificException(EPROTO, "Invalid snapshot chain: " + chain);
+            }
+            if ((enabled && isMeteredChain(chain)) || !result.add(chain)) {
+                throw new ServiceSpecificException(EPROTO, "Invalid/duplicate snapshot chain: " + chain);
+            }
+        }
+        return result;
+    }
+
+    /** Actual native ACK-known status, serialized with this owner's mutations/replay. */
+    public synchronized int getUidNetworkingBlockedReasons(int uid) throws RemoteException {
+        checkUid(uid);
+        // Preserve the platform's unconditional exemption before any policy read/replay.
+        if (UserHandle.getAppId(uid) < Process.FIRST_APPLICATION_UID) return BLOCKED_REASON_NONE;
+        ensureReplayed();
+        return invoke(() -> {
+            final TronaUidBlockedStatus status = mBackend.getTronaUidBlockedStatus(uid);
+            if (status == null) throw new ServiceSpecificException(EPROTO, "Missing blocked status");
+            final Set<Integer> enabled = checkedSnapshotChains(status.enabledChains, true);
+            final Set<Integer> denied = checkedSnapshotChains(status.deniedChains, false);
+            int reasons = BLOCKED_REASON_NONE;
+            for (int chain : enabled) {
+                if (!denied.contains(chain)) continue;
+                switch (chain) {
+                    case FIREWALL_CHAIN_POWERSAVE: reasons |= BLOCKED_REASON_BATTERY_SAVER; break;
+                    case FIREWALL_CHAIN_DOZABLE: reasons |= BLOCKED_REASON_DOZE; break;
+                    case FIREWALL_CHAIN_STANDBY: reasons |= BLOCKED_REASON_APP_STANDBY; break;
+                    case FIREWALL_CHAIN_RESTRICTED: reasons |= BLOCKED_REASON_RESTRICTED_MODE; break;
+                    case FIREWALL_CHAIN_LOW_POWER_STANDBY: reasons |= BLOCKED_REASON_LOW_POWER_STANDBY; break;
+                    case FIREWALL_CHAIN_BACKGROUND: reasons |= BLOCKED_REASON_APP_BACKGROUND; break;
+                    case FIREWALL_CHAIN_OEM_DENY_1:
+                    case FIREWALL_CHAIN_OEM_DENY_2:
+                    case FIREWALL_CHAIN_OEM_DENY_3: reasons |= BLOCKED_REASON_OEM_DENY; break;
+                    default: throw new ServiceSpecificException(EPROTO, "Invalid enabled chain");
+                }
+            }
+            if (denied.contains(FIREWALL_CHAIN_METERED_DENY_USER)) {
+                reasons |= BLOCKED_METERED_REASON_USER_RESTRICTED;
+            }
+            if (denied.contains(FIREWALL_CHAIN_METERED_DENY_ADMIN)) {
+                reasons |= BLOCKED_METERED_REASON_ADMIN_DISABLED;
+            }
+            if (denied.contains(FIREWALL_CHAIN_METERED_ALLOW) && status.dataSaverEnabled) {
+                reasons |= BLOCKED_METERED_REASON_DATA_SAVER;
+            }
+            return reasons;
+        });
+    }
+
+    /** Membership only; the caller distinguishes allow-list and deny-list chains. */
+    public synchronized Set<Integer> getUidsOnChain(int chain) throws RemoteException {
+        isAllowChain(chain);
+        ensureReplayed();
+        return Set.copyOf(mMembers.get(chain));
+    }
+}
