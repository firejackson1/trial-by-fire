package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Preserve the actual vendor target level and its original kernel requirements.
// This module is installed only by the experimental trona product.
vintf_compatibility_matrix {
    name: "framework_compatibility_matrix.3.xml",
    stem: "compatibility_matrix.3.xml",
    srcs: ["compatibility_matrix.3.xml"],
    kernel_configs: [
        "kernel_config_p_4.4",
        "kernel_config_p_4.9",
        "kernel_config_p_4.14",
    ],
}
